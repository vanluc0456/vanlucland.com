function vld_register_sidebars() {
    register_sidebar(array(
        'name'          => __('Sidebar BDS', 'vanlucland-developer'),
        'id'            => 'sidebar-bds',
        'description'   => __('Sidebar hiển thị bên phải khu vực dự án', 'vanlucland-developer'),
        'before_widget' => '<div class="sidebar-widget">',
        'after_widget'  => '</div>',
        'before_title'  => '<h3 class="widget-title"><span>',
        'after_title'   => '</span></h3>',
    ));
}
add_action('widgets_init', 'vld_register_sidebars');

// =====================================================
// 4. WordPress Customizer — Theme Options (Giao diện → Tùy biến)
// =====================================================
/**
 * Return published projects and posts that can be selected as a Hero CTA.
 * Post IDs are shared across post types, so a single integer setting is both
 * compact and resilient when titles or permalinks change later.
 */
function vld_hero_target_choices() {
    $choices = array(
        0 => __('— Chọn bài viết hoặc dự án —', 'vanlucland-developer'),
    );

    $content_types = array(
        'du_an' => __('Dự án', 'vanlucland-developer'),
        'post'  => __('Bài viết', 'vanlucland-developer'),
    );

    foreach ($content_types as $post_type => $group_label) {
        $items = get_posts(array(
            'post_type'              => $post_type,
            'post_status'            => 'publish',
            'posts_per_page'         => -1,
            'orderby'                => 'title',
            'order'                  => 'ASC',
            'no_found_rows'          => true,
            'update_post_meta_cache' => false,
            'update_post_term_cache' => false,
        ));

        foreach ($items as $item) {
            $title = get_the_title($item);
            if ('' === trim((string) $title)) {
                $title = sprintf(__('Nội dung #%d', 'vanlucland-developer'), $item->ID);
            }
            $choices[$item->ID] = $group_label . ' — ' . $title;
        }
    }

    return $choices;
}

/**
 * Store only IDs belonging to a project or a normal post.
 */
function vld_sanitize_hero_target($value) {
    $post_id = absint($value);
    if (!$post_id) {
        return 0;
    }

    return in_array(get_post_type($post_id), array('du_an', 'post'), true) ? $post_id : 0;
}

/**
 * Keep the autoplay delay within a calm, readable 3–12 second range.
 */
function vld_sanitize_hero_delay($value) {
    return min(12, max(3, absint($value)));
}

/**
 * Resolve the selected content at render time so permalink changes are
 * reflected automatically. Deleted or unpublished targets fall back safely.
 */
function vld_hero_target_url($post_id) {
    $post_id = vld_sanitize_hero_target($post_id);
    if ($post_id && 'publish' === get_post_status($post_id)) {
        $permalink = get_permalink($post_id);
        if ($permalink) {
            return $permalink;
        }
    }

    return '#du-an';
}

function vld_customize_register($wp_customize) {
    if (!class_exists('VLD_Customize_Sortable_Control')) {
        /**
         * Small drag-and-drop control for reordering the four footer blocks.
         * It stores a comma-separated list and falls back safely if a value is
         * missing after a theme update.
         */
        class VLD_Customize_Sortable_Control extends WP_Customize_Control {
            public $type = 'vld_sortable';

            public function render_content() {
                $current = array_filter(array_map('sanitize_key', explode(',', (string) $this->value())));
                ?>
                <label>
                    <?php if ($this->label) : ?>
                        <span class="customize-control-title"><?php echo esc_html($this->label); ?></span>
                    <?php endif; ?>
                    <?php if ($this->description) : ?>
                        <span class="description customize-control-description"><?php echo esc_html($this->description); ?></span>
                    <?php endif; ?>
                    <input class="vld-sortable-value" type="hidden" value="<?php echo esc_attr(implode(',', $current)); ?>" <?php $this->link(); ?>>
                </label>
                <ul class="vld-sortable-list">
                    <?php foreach ($current as $item) : ?>
                        <?php if (isset($this->choices[$item])) : ?>
                            <li class="vld-sortable-item" data-value="<?php echo esc_attr($item); ?>">
                                <span class="dashicons dashicons-move vld-sortable-handle" aria-hidden="true"></span>
                                <span><?php echo esc_html($this->choices[$item]); ?></span>
                            </li>
                        <?php endif; ?>
                    <?php endforeach; ?>
                </ul>
                <?php
            }
        }
    }

    // -------------------------------------------------
    // SECTION 1: Thông tin thương hiệu & Logo
    // -------------------------------------------------
    $wp_customize->add_section('vld_brand_section', array(
        'title'    => __('1. Tên thương hiệu & Logo', 'vanlucland-developer'),
        'priority' => 20,
    ));

