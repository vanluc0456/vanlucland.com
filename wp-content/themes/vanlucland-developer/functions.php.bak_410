        overflow: hidden !important;
    }
    .project-card .card-meta span.card-location {
        font-size: 9.5px !important;
        line-height: 13px !important;
        height: 26px !important;
        max-height: 26px !important;
        color: #475569 !important;
        display: -webkit-box !important;
        -webkit-line-clamp: 2 !important;
        -webkit-box-orient: vertical !important;
        overflow: hidden !important;
        white-space: normal !important;
    }
    .project-card .card-meta span.card-area {
        font-size: 9.5px !important;
        line-height: 12px !important;
        height: 12px !important;
        color: #475569 !important;
        display: block !important;
        white-space: nowrap !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
    }
    /* 4. Bottom Price Tag: Equal bottom baseline */
    .project-card .card-price {
        margin-top: auto !important;
        padding-top: 4px !important;
        border-top: 1px dashed #e2e8f0 !important;
        height: 20px !important;
        min-height: 20px !important;
        line-height: 16px !important;
        display: flex !important;
        align-items: center !important;
        font-size: 10px !important;
        color: #C41E3A !important;
        font-weight: 700 !important;
        white-space: nowrap !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
    }
    .project-card .card-price strong {
        font-size: 10.5px !important;
        color: #C41E3A !important;
        font-weight: 800 !important;
        white-space: nowrap !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
    }
    .archive-card__excerpt, .archive-card__link {
        display: none !important;
    }
}
</style>"; }, 999);

// PageSpeed: Defer non-critical scripts
add_filter("script_loader_tag", function($tag, $handle, $src) {
    if (is_admin()) return $tag;
    if (strpos($src, "googletagmanager.com") !== false || strpos($src, "google-analytics.com") !== false) {
        if (strpos($tag, "defer") === false && strpos($tag, "async") === false) {
            $tag = str_replace("<script ", "<script defer ", $tag);
        }
    }
    return $tag;
}, 10, 3);

// PageSpeed: Load Google Tag Manager / Site Kit after user interaction or idle
add_filter("script_loader_tag", function($tag, $handle, $src) {
    if (is_admin()) return $tag;
    if ($handle === "google_gtagjs-js" || strpos($src, "googletagmanager.com/gtag/js") !== false) {
        return "<script>
(function() {
    var loaded = false;
    function initGTM() {
        if (loaded) return;
        loaded = true;
        var s = document.createElement(\"script\");
        s.src = \"" . esc_url($src) . "\";
        s.async = true;
        document.head.appendChild(s);
    }
    [\"scroll\", \"touchstart\", \"mousemove\", \"keydown\", \"click\"].forEach(function(e) {
        window.addEventListener(e, initGTM, {once: true, passive: true});
    });
    if (\"requestIdleCallback\" in window) {
        requestIdleCallback(function() { setTimeout(initGTM, 3500); });
    } else {
        setTimeout(initGTM, 4000);
    }
})();
</script>";
    }
    return $tag;
}, 999, 3);

/**
 * Clean & optimize archive titles (Remove "Lưu trữ: " prefix, set custom H1 for Projects)
 */
add_filter("get_the_archive_title", function ($title) {
    if (is_post_type_archive("du_an")) {
        return "Dự Án Bất Động Sản Đang Phân Phối Tại TP.HCM";
    }
    if (is_category() || is_tag() || is_tax()) {
        return single_term_title("", false);
    }
    if (is_author()) {
        return "Tác giả: " . get_the_author();
    }
    return $title;
});

