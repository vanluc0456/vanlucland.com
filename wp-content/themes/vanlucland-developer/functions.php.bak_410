add_action("wp_head", function() { echo "<style>
/* ==========================================================================
   PIXEL-PERFECT 2-COLUMN MOBILE PROJECT GRID ALIGNMENT & COMPACT SPACING
   ========================================================================== */
@media (max-width: 1023px) {
