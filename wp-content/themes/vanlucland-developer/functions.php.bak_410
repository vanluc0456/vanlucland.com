// Automatically set tabindex="-1" on initial mobile menu links for accessibility
add_filter("nav_menu_link_attributes", function($atts, $item, $args) {
    if (isset($args->theme_location) && $args->theme_location === "mobile") {
        $atts["tabindex"] = "-1";
    }
    return $atts;
}, 10, 3);

