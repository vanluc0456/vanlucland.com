function vld_save_project_meta($post_id) {
    if (defined('DOING_AUTOSAVE') && DOING_AUTOSAVE) {
        return;
    }
    if (wp_is_post_revision($post_id)) {
        return;
    }
    if (!current_user_can('edit_post', $post_id)) {
        return;
    }

    $post_type = get_post_type($post_id);
    if (!in_array($post_type, array('du_an', 'post'), true)) {
        return;
    }

    $project_nonce = sanitize_text_field(wp_unslash($_POST['vld_project_nonce'] ?? ''));
    if ('du_an' === $post_type && $project_nonce && wp_verify_nonce($project_nonce, 'vld_save_project')) {
        $fields = array('price', 'area', 'location', 'developer', 'category', 'legal', 'badge');
        foreach ($fields as $field) {
            if (isset($_POST['vld_' . $field])) {
                update_post_meta(
                    $post_id,
                    '_vld_' . $field,
                    sanitize_text_field(wp_unslash($_POST['vld_' . $field]))
                );
            }
        }
    }

    $position_nonce = sanitize_text_field(wp_unslash($_POST['vld_pos_nonce'] ?? ''));
    if ($position_nonce && wp_verify_nonce($position_nonce, 'vld_save_display_positions')) {
        $pos_fields = 'du_an' === $post_type
            ? array('show_featured', 'show_sidebar')
            : array('show_news');
        foreach ($pos_fields as $pos) {
            $val = isset($_POST['vld_' . $pos]) ? '1' : '0';
            update_post_meta($post_id, '_vld_' . $pos, $val);
        }
    }
}
add_action('save_post', 'vld_save_project_meta');

function vld_get_project_meta($post_id, $key) {
    $val = get_post_meta($post_id, '_vld_' . $key, true);
    if ('' === $val || null === $val || false === $val) {
        $val = get_post_meta($post_id, 'vld_project_' . $key, true);
    }
    if ('' === $val || null === $val || false === $val) {
        $val = get_post_meta($post_id, 'vld_' . $key, true);
    }
    if ('' === $val || null === $val || false === $val) {
        if ('area' === $key) {
            $val = get_post_meta($post_id, 'vld_project_scale', true);
        } elseif ('location' === $key) {
            $val = get_post_meta($post_id, 'dia_chi', true);
        } elseif ('developer' === $key) {
            $val = get_post_meta($post_id, 'chu_dau_tu', true);
        } elseif ('price' === $key) {
            $val = get_post_meta($post_id, 'gia_tu', true);
        } elseif ('legal' === $key) {
            $val = get_post_meta($post_id, 'phap_ly', true);
        } elseif ('category' === $key) {
            $type = get_post_meta($post_id, '_vld_type', true);
            if ('dat-nen' === $type) {
                $val = 'Đất nền sổ đỏ';
            } elseif ('biet-thu' === $type) {
                $val = 'Nhà phố / Biệt thự';
            } elseif ('can-ho' === $type) {
                $val = 'Căn hộ chung cư';
            }
        }
    }
    return $val;
}

/**
 * Return featured/pinned items first, then fill the remaining slots with the
 * newest content. This makes every admin priority control visible on the site
 * without hiding ordinary recent content.
 */
function vld_get_prioritized_post_ids($post_type, $meta_key, $limit, $exclude_ids = array()) {
    $post_type   = sanitize_key($post_type);
    $meta_key    = sanitize_key($meta_key);
    $limit       = max(1, absint($limit));
    $exclude_ids = array_values(array_filter(array_map('absint', (array) $exclude_ids)));

    $common_args = array(
        'post_type'              => $post_type,
        'post_status'            => 'publish',
        'posts_per_page'         => $limit,
        'fields'                 => 'ids',
        'orderby'                => 'date',
        'order'                  => 'DESC',
        'ignore_sticky_posts'    => true,
        'no_found_rows'          => true,
        'update_post_meta_cache' => false,
        'update_post_term_cache' => false,
        'post__not_in'           => $exclude_ids,
    );

    $priority_ids = get_posts(
        array_merge(
            $common_args,
            array(
                'meta_key'   => $meta_key,
                'meta_value' => '1',
            )
        )
    );

    $remaining = $limit - count($priority_ids);
    if ($remaining < 1) {
        return array_slice(array_map('absint', $priority_ids), 0, $limit);
    }

    $latest_ids = get_posts(
        array_merge(
            $common_args,
            array(
                'posts_per_page' => $remaining,
                'post__not_in'   => array_values(array_unique(array_merge($exclude_ids, $priority_ids))),
            )
        )
    );

    return array_map('absint', array_merge($priority_ids, $latest_ids));
}

// =====================================================
// 10. Admin Columns — Cột thông tin trong admin dự án
// =====================================================
function vld_project_admin_columns($columns) {
    $new_columns = array();
    $new_columns['cb']          = $columns['cb'];
    $new_columns['title']       = 'Tên dự án';
    $new_columns['vld_type']     = 'Loại hình';
    $new_columns['vld_price']    = 'Giá';
    $new_columns['vld_location'] = 'Vị trí';
    $new_columns['vld_badge']    = 'Badge';
    $new_columns['vld_priority'] = 'Ưu tiên';
    $new_columns['thumbnail']   = 'Ảnh';
    $new_columns['date']        = $columns['date'];
    return $new_columns;
}
add_filter('manage_du_an_posts_columns', 'vld_project_admin_columns');

function vld_project_admin_column_data($column, $post_id) {
    switch ($column) {
        case 'vld_type':
            $type_label = vld_get_project_type_label($post_id);
            echo esc_html($type_label ? $type_label : '—');
            break;
        case 'vld_price':
            echo esc_html(vld_get_project_meta($post_id, 'price'));
            break;
        case 'vld_location':
            echo esc_html(vld_get_project_meta($post_id, 'location'));
            break;
        case 'vld_badge':
            $badge = vld_get_project_meta($post_id, 'badge');
            $labels = array('badge-hot' => 'HOT', 'badge-selling' => 'Đang bán', 'badge-new' => 'Mới');
            echo esc_html($labels[$badge] ?? '—');
            break;
        case 'vld_priority':
            $priorities = array();
            if ('1' === get_post_meta($post_id, '_vld_show_featured', true)) {
                $priorities[] = 'Trang chủ';
            }
            if ('1' === get_post_meta($post_id, '_vld_show_sidebar', true)) {
                $priorities[] = 'Sidebar';
            }
            echo esc_html($priorities ? implode(', ', $priorities) : '—');
            break;
        case 'thumbnail':
            if (has_post_thumbnail($post_id)) {
                echo get_the_post_thumbnail($post_id, array(60, 60));
            } else {
                echo '—';
            }
            break;
    }
}
add_action('manage_du_an_posts_custom_column', 'vld_project_admin_column_data', 10, 2);

