    $same_as = vld_schema_same_as();
    if ($same_as) {
        $schema['sameAs'] = $same_as;
    }

    return $schema;
}

function vld_breadcrumb_schema() {
    if (is_front_page()) {
        return array();
    }

    $items = array(
        array(
            '@type'    => 'ListItem',
            'position' => 1,
            'name'     => 'Trang chủ',
            'item'     => home_url('/'),
        ),
    );

    if (is_singular('du_an')) {
        $items[] = array(
            '@type'    => 'ListItem',
            'position' => 2,
            'name'     => 'Dự án',
            'item'     => get_post_type_archive_link('du_an'),
        );
    } elseif (is_singular('post')) {
        $categories = get_the_category(get_queried_object_id());
        if ($categories) {
            $items[] = array(
                '@type'    => 'ListItem',
                'position' => 2,
                'name'     => $categories[0]->name,
                'item'     => get_category_link($categories[0]->term_id),
            );
        }
    }

    if (is_singular()) {
        $items[] = array(
            '@type'    => 'ListItem',
            'position' => count($items) + 1,
            'name'     => get_the_title(get_queried_object_id()),
            'item'     => get_permalink(get_queried_object_id()),
        );
    } elseif (is_category()) {
        $items[] = array(
            '@type'    => 'ListItem',
            'position' => 2,
            'name'     => single_cat_title('', false),
            'item'     => get_category_link(get_queried_object_id()),
        );
    } elseif (is_post_type_archive()) {
        $items[] = array(
            '@type'    => 'ListItem',
            'position' => 2,
            'name'     => post_type_archive_title('', false),
            'item'     => get_post_type_archive_link(get_query_var('post_type')),
        );
    }

    if (count($items) < 2) {
        return array();
    }

    return array(
        '@type'           => 'BreadcrumbList',
        '@id'             => vld_current_canonical_url() . '#breadcrumb',
        'itemListElement' => $items,
    );
}

/**
 * Enhance Rank Math's graph instead of printing a second competing graph.
 */
function vld_rank_math_schema($data, $jsonld) {
    $organization_found = false;
    $organization_id    = home_url('/#organization');
    $business_key       = null;
    foreach ($data as $key => $entity) {
        $types = isset($entity['@type']) ? (array) $entity['@type'] : array();
        if (!array_intersect($types, array('Organization', 'RealEstateAgent'))) {
            continue;
        }

        // Keep one canonical business node. Rank Math or an older schema
        // extension may otherwise leave a second RealEstateAgent in the graph.
        if (null !== $business_key) {
            unset($data[$key]);
            continue;
        }

        $organization_found = true;
        $business_key       = $key;
        $agent = vld_real_estate_agent_schema();
        $data[$key] = array_merge($entity, $agent);

        // Rank Math can retain Person from an older knowledge-graph setting.
        // A business entity must stay Organization + RealEstateAgent; the
        // article author remains a separate Person in Article.author.
        $business_types = array_values(array_diff($types, array('Person')));
        $data[$key]['@type'] = array_values(
            array_unique(array_merge($business_types, array('Organization', 'RealEstateAgent')))
        );
        $data[$key]['@id'] = $organization_id;
    }

    if (!$organization_found && is_front_page()) {
        $data['vld-real-estate-agent'] = vld_real_estate_agent_schema();
    }

    $has_breadcrumb = false;
    foreach ($data as $key => $entity) {
        if (in_array('BreadcrumbList', (array) ($entity['@type'] ?? array()), true)) {
            if ($has_breadcrumb) {
                unset($data[$key]);
                continue;
            }
            $has_breadcrumb = true;
        }
    }

    $breadcrumb = vld_breadcrumb_schema();
    if (!$has_breadcrumb && $breadcrumb) {
        $data['vld-breadcrumb'] = $breadcrumb;
    }

    if (is_singular('post')) {
        $has_article = false;
        foreach ($data as $entity) {
            $types = (array) ($entity['@type'] ?? array());
            if (array_intersect($types, array('Article', 'BlogPosting', 'NewsArticle'))) {
                $has_article = true;
                break;
            }
        }

        if (!$has_article) {
            $article                       = vld_article_schema(get_queried_object_id());
            $article['publisher']['@id']   = $organization_id;
            $data['vld-article']           = $article;
        }
    }

    /*
     * Normalize article relationships against the single business entity.
     * Rank Math can retain a stale #person publisher after the Knowledge Graph
     * is switched from Person to Organization, leaving an unresolved node.
     */
    if (is_singular(array('post', 'du_an'))) {
        $post_id       = get_queried_object_id();
        $canonical     = vld_current_canonical_url();
        $article_id    = $canonical . '#article';
        $author_node_id = $canonical . '#author';
        $author_user_id = (int) get_post_field('post_author', $post_id);
        $author_name    = trim((string) get_the_author_meta('display_name', $author_user_id));
        $author_name    = $author_name ?: 'Văn Lực';
        $author_profile_url = home_url('/gioi-thieu/');
        $image_url      = get_the_post_thumbnail_url($post_id, 'full');
        $has_article    = false;
        $author_key     = null;

        foreach ($data as $key => $entity) {
            $types = (array) ($entity['@type'] ?? array());
            if (array_intersect($types, array('Article', 'BlogPosting', 'NewsArticle'))) {
                $has_article = true;
                if (empty($data[$key]['@id'])) {
                    $data[$key]['@id'] = $article_id;
                }
                $data[$key]['mainEntityOfPage'] = array('@id' => $canonical . '#webpage');
                $data[$key]['author'] = array('@id' => $author_node_id);
                $data[$key]['publisher'] = array('@id' => $organization_id);
                $data[$key]['copyrightHolder'] = array('@id' => $organization_id);

                foreach (array('headline', 'name', 'description') as $text_key) {
                    if (!empty($data[$key][$text_key])) {
                        $decoded_text = wp_strip_all_tags((string) $data[$key][$text_key]);
                        // Some imported Rank Math titles were encoded twice.
                        for ($decode_pass = 0; $decode_pass < 3; $decode_pass++) {
                            $next_text = html_entity_decode($decoded_text, ENT_QUOTES | ENT_HTML5, 'UTF-8');
                            if ($next_text === $decoded_text) {
                                break;
                            }
                            $decoded_text = $next_text;
                        }
                        $data[$key][$text_key] = $decoded_text;
                    }
                }

                if ($image_url && empty($data[$key]['image'])) {
                    $data[$key]['image'] = array($image_url);
                }
            }

            if (
                in_array('Person', $types, true)
                && isset($entity['@id'])
                && '#author' === substr((string) $entity['@id'], -7)
            ) {
                $author_key = $key;
            }
        }

        if ($has_article) {
            if (null === $author_key) {
                $author_key = 'vld-author';
                $data[$author_key] = array('@type' => 'Person');
            }
            $data[$author_key]['@type'] = 'Person';
            $data[$author_key]['@id'] = $author_node_id;
            $data[$author_key]['name'] = $author_name;
            $data[$author_key]['url'] = $author_profile_url;
        }
    }

    // Google does not show self-serving review snippets for an Organization or
    // LocalBusiness on its own site. Keep review/rating markup out of this
    // business graph while leaving visible customer comments untouched.
    foreach ($data as $key => $entity) {
        $types = (array) ($entity['@type'] ?? array());
        if (array_intersect($types, array('Review', 'Rating', 'AggregateRating'))) {
            unset($data[$key]);
        }
    }

    $remove_unverified_ratings = static function ($value) use (&$remove_unverified_ratings) {
        if (!is_array($value)) {
            return $value;
        }
        unset($value['aggregateRating'], $value['review'], $value['reviewRating']);
        foreach ($value as $key => $child) {
            $value[$key] = $remove_unverified_ratings($child);
        }
        return $value;
    };

    return $remove_unverified_ratings(array_values($data));
}
add_filter('rank_math/json_ld', 'vld_rank_math_schema', 90, 2);

function vld_seo_head_markup() {
    if (vld_has_seo_plugin()) {
        return;
    }

    $site_name = vld_option('brand_name', 'Văn Lực Land');
    $site_desc = is_front_page() ? vld_front_page_seo_description() : wp_strip_all_tags(get_the_excerpt());
    $permalink = vld_current_canonical_url();
    $og_image  = vld_social_image_url();

    if (!$site_desc) {
        $site_desc = get_bloginfo('description');
    }

    echo '<meta name="description" content="' . esc_attr($site_desc) . '">' . "\n";
    if (!is_search() && !is_404()) {
        echo '<link rel="canonical" href="' . esc_url($permalink) . '">' . "\n";
    }

    echo '<meta property="og:type" content="' . (is_single() ? 'article' : 'website') . '" />' . "\n";
    echo '<meta property="og:url" content="' . esc_url($permalink) . '" />' . "\n";
    echo '<meta property="og:title" content="' . esc_attr(wp_get_document_title()) . '" />' . "\n";
    echo '<meta property="og:description" content="' . esc_attr($site_desc) . '" />' . "\n";
    echo '<meta property="og:image" content="' . esc_url($og_image) . '" />' . "\n";
    $og_attachment_id = attachment_url_to_postid($og_image);
    if ($og_attachment_id) {
        $og_meta = wp_get_attachment_metadata($og_attachment_id);
        if (!empty($og_meta['width']) && !empty($og_meta['height'])) {
            echo '<meta property="og:image:width" content="' . esc_attr($og_meta['width']) . '" />' . "\n";
            echo '<meta property="og:image:height" content="' . esc_attr($og_meta['height']) . '" />' . "\n";
        }
    }
    echo '<meta property="og:image:alt" content="' . esc_attr(wp_get_document_title()) . '" />' . "\n";
    echo '<meta property="og:site_name" content="' . esc_attr($site_name) . '" />' . "\n";
    echo '<meta property="og:locale" content="vi_VN" />' . "\n";

    echo '<meta name="twitter:card" content="summary_large_image" />' . "\n";
    echo '<meta name="twitter:title" content="' . esc_attr(wp_get_document_title()) . '" />' . "\n";
    echo '<meta name="twitter:description" content="' . esc_attr($site_desc) . '" />' . "\n";
    echo '<meta name="twitter:image" content="' . esc_url($og_image) . '" />' . "\n";
    echo '<meta name="twitter:image:alt" content="' . esc_attr(wp_get_document_title()) . '" />' . "\n";

    // The former Sitelinks Search Box action is intentionally omitted because
    // Google retired that visual feature in November 2024.
    if (is_front_page()) {
        $schema = array(
            '@context' => 'https://schema.org',
            '@graph'   => array(
                vld_real_estate_agent_schema(),
                array(
                    '@type' => 'WebSite',
                    '@id'   => home_url('/#website'),
                    'url'   => home_url('/'),
                    'name'  => vld_option('brand_name', 'Văn Lực Land'),
                ),
            ),
        );
        echo '<script type="application/ld+json">' . wp_json_encode($schema, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) . '</script>' . "\n";
    } else {
        $graph      = array();
        $breadcrumb = vld_breadcrumb_schema();

        if (is_singular('post')) {
            $graph[] = vld_real_estate_agent_schema();
            $graph[] = vld_article_schema(get_queried_object_id());
        }
        if ($breadcrumb) {
            $graph[] = $breadcrumb;
        }

        if ($graph) {
            echo '<script type="application/ld+json">' . wp_json_encode(
                array(
                    '@context' => 'https://schema.org',
                    '@graph'   => $graph,
                ),
                JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES
            ) . '</script>' . "\n";
        }
    }
}
add_action('wp_head', 'vld_seo_head_markup');

function vld_disable_core_canonical_when_using_fallback() {
    if (!vld_has_seo_plugin()) {
        remove_action('wp_head', 'rel_canonical');
    }
}
add_action('wp', 'vld_disable_core_canonical_when_using_fallback');

/**
 * Return the live sitemap managed by the active SEO layer.
 *
 * Rank Math and Yoast use sitemap_index.xml. AIOSEO uses sitemap.xml. When no
 * SEO plugin is active, WordPress core keeps the sitemap current at
 * wp-sitemap.xml. A static XML file inside the theme would become stale as
 * soon as a post or project is published.
 */
function vld_sitemap_url() {
    if (
        defined('RANK_MATH_VERSION')
        || class_exists('RankMath')
        || defined('WPSEO_VERSION')
    ) {
        return home_url('/sitemap_index.xml');
    }

    if (defined('AIOSEO_VERSION')) {
        return home_url('/sitemap.xml');
    }

    return home_url('/wp-sitemap.xml');
}

/**
 * Serve the root /robots.txt through WordPress, so the one theme ZIP is enough
 * and there is no separate file to upload to public_html.
 *
 * WordPress bypasses this filter when a physical robots.txt already exists.
 * The website privacy setting is respected: when indexing is disabled, core
 * WordPress keeps its blocking response.
 */
function vld_virtual_robots_txt($output, $public) {
    if ('0' === (string) $public) {
        return $output;
    }

    $rules = array(
        'User-agent: *',
        'Disallow: /wp-admin/',
        'Disallow: /wp-login.php',
        'Disallow: /xmlrpc.php',
        'Disallow: /?s=',
        'Disallow: /search/',
        'Disallow: /*?replytocom=',
        'Disallow: /wp-json/',
        'Allow: /wp-json/oembed/',
        'Disallow: /wp-includes/',
        'Allow: /wp-includes/js/',
        'Allow: /wp-includes/css/',
        'Disallow: /cgi-bin/',
        'Disallow: /trackback/',
        'Allow: /feed/',
        'Disallow: /comments/feed/',
        'Disallow: /*/feed/',
        'Allow: /wp-admin/admin-ajax.php',
        'Allow: /wp-content/uploads/',
        '',
        '# AI Search & GEO Crawlers',
        'User-agent: GPTBot',
        'Allow: /',
        '',
        'User-agent: ClaudeBot',
        'Allow: /',
        '',
        'User-agent: PerplexityBot',
        'Allow: /',
        '',
        'User-agent: Applebot-Extended',
        'Allow: /',
        '',
        'User-agent: Google-Extended',
        'Allow: /',
        '',
        'User-agent: Bytespider',
        'Allow: /',
        '',
        '# Aggressive Scraper Throttling',
        'User-agent: AhrefsBot',
        'Crawl-delay: 10',
        '',
        'User-agent: SemrushBot',
        'Crawl-delay: 10',
        '',
        'User-agent: DotBot',
        'Disallow: /',
        '',
        'User-agent: MJ12bot',
        'Disallow: /',
        '',
        'Sitemap: ' . vld_sitemap_url(),
    );

    return implode("\n", $rules) . "\n";
}
add_filter('robots_txt', 'vld_virtual_robots_txt', 99, 2);

/**
 * Keep the familiar /sitemap.xml address working without maintaining a second
 * sitemap. Rank Math remains authoritative on the current installation; core
 * WordPress is the automatic fallback when the SEO plugin is unavailable.
 */
function vld_redirect_sitemap_alias() {
    if (is_admin() || wp_doing_ajax()) {
        return;
    }

    $request_path = isset($_SERVER['REQUEST_URI'])
        ? wp_parse_url(wp_unslash($_SERVER['REQUEST_URI']), PHP_URL_PATH)
        : '';
    $alias_path   = wp_parse_url(home_url('/sitemap.xml'), PHP_URL_PATH);
    $target       = vld_sitemap_url();

    if (
        $request_path
        && untrailingslashit($request_path) === untrailingslashit($alias_path)
        && untrailingslashit($target) !== untrailingslashit(home_url('/sitemap.xml'))
    ) {
        wp_safe_redirect($target, 301, 'Văn Lực Land');
        exit;
    }
}
add_action('template_redirect', 'vld_redirect_sitemap_alias', 0);

/**
 * Redirect verified legacy content URLs to their exact replacement pages.
 *
 * Keep this list deliberately small: unrelated missing URLs must continue to
 * return a real 404 instead of being sent to the homepage.
 */
function vld_redirect_verified_legacy_content() {
    if (is_admin() || wp_doing_ajax()) {
        return;
    }

    $method = isset($_SERVER['REQUEST_METHOD'])
        ? strtoupper(sanitize_text_field(wp_unslash($_SERVER['REQUEST_METHOD'])))
        : 'GET';
    if (!in_array($method, array('GET', 'HEAD'), true)) {
        return;
    }

    $request_path = isset($_SERVER['REQUEST_URI'])
        ? wp_parse_url(wp_unslash($_SERVER['REQUEST_URI']), PHP_URL_PATH)
        : '';
    if (!$request_path) {
        return;
    }

    $request_path = '/' . ltrim(rawurldecode($request_path), '/');
    $lookup_path = untrailingslashit($request_path);

    // Strip crawler-appended phone, sms, or null suffixes and redirect 301 to canonical page
    if (preg_match('#^(.+)/(tel:[0-9+]+|sms:[0-9+]+|[0-9]{10}|null)$#i', $lookup_path, $matches)) {
        wp_safe_redirect(home_url($matches[1] . '/'), 301, 'Văn Lực Land');
        exit;
    }

    // Redirect legacy attachment URLs or deleted post subpages
    if (preg_match('#^/(can-ho-imperium-town-nha-trang|five-star-eco-city-khu-do-thi|du-an-the-sky-riverside-long-an|du-an-dat-tho-cu-loc-tan-bao-loc|du-an-can-ho-essensia-nam-sai-gon|du-an-can-ho-bcons-bee|du-an-can-ho-d-aqua|du-an-can-ho-the-myra-tan-hung|du-an-the-5-way-phu-quoc-can-ho-bien-vinhomes|du-an-casa-marina-premium-quy-nhon|can-ho-essensia-sky|du-an-the-apus-phuoc-hai-ba-ria-vung-tau-2)/#i', $lookup_path)) {
        wp_safe_redirect(home_url('/du-an/'), 301, 'Văn Lực Land');
        exit;
    }

    $legacy_map = array(
        '/bang-tinh-lai-vay-mua-nha-tra-gop' => '/bang-tinh-lai-vay/',
        '/du-an/the-classia-khang-dien-⭐️【gia-16-ty-can-lo-dep-nhat】' => '/du-an/the-classia-khang-dien-thu-duc/',
        '/du-an/can-ho-ansana-by-kita' => '/can-ho-ansana-by-kita-vo-van-kiet-binh-tan/',
        '/du-an/can-ho-the-win-city' => '/8-ly-do-de-an-cu-va-dau-tu-tai-the-win-city-can-ho-cua-ngo-tay-sai-gon/',
        '/du-an/du-an-arcadia-at-lavila' => '/du-an/can-ho-arcadia-at-lavila/',
        '/du-an/co-nen-mua-arcadia-at-lavila-khong-goc-nhin-thuc-te-cho-nguoi-mua-o-va-nha-dau-tu' => '/du-an/can-ho-arcadia-at-lavila/',
        '/tin-tuc/co-nen-mua-arcadia-at-lavila' => '/co-nen-mua-arcadia-at-lavila-khong/',
        '/co-nen-mua-arcadia-at-lavila-khong-goc-nhin-thuc-te-cho-nguoi-mua-o-va-nha-dau-tu' => '/co-nen-mua-arcadia-at-lavila-khong/',
        '/tin-tuc/9-ly-do-dang-can-nhac-de-o-va-dau-tu-tai-ansana-by-kita' => '/9-ly-do-dang-can-nhac-de-o-va-dau-tu-tai-ansana-by-kita/',
        '/du-thuc-hien' => '/du-an/',
        '/project/celesta-gold-nha-be' => '/du-an/can-ho-celesta-gold/',
        '/project/du-an-arcadia-at-lavila' => '/du-an/can-ho-arcadia-at-lavila/',
        '/project/trellia-cove-nam-long-oc-dao-xanh-tai-mizuki-park' => '/du-an/trellia-cove-nam-long-phan-khu-compound-cuoi-cung-tai-mizuki-park-oc-dao-xanh/',
        '/project/can-ho-the-win-city' => '/8-ly-do-de-an-cu-va-dau-tu-tai-the-win-city-can-ho-cua-ngo-tay-sai-gon/',
        '/8-ly-do-de-an-cu-va-dau-tu-tai-the-win-city-duc-hoa-long-an' => '/8-ly-do-de-an-cu-va-dau-tu-tai-the-win-city-can-ho-cua-ngo-tay-sai-gon/',
        '/project/danh-gia-chi-tiet-tbs-green-skyline-green-tower-di-an' => '/danh-gia-chi-tiet-tbs-green-skyline-green-tower-di-an-tam-diem-can-ho-cao-cap-tai-tp-di-an/',
        '/project/can-ho-ansana-by-kita' => '/can-ho-ansana-by-kita-vo-van-kiet-binh-tan/',
        '/bds' => '/du-an/',
        '/project' => '/du-an/',

        // Consolidated September 2026 after a full similarity audit. These
