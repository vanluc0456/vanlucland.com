/**
 * Disable WordPress auto-sizes on lazy-loaded images to prevent high-DPR mobile devices
 * from picking oversized srcset candidates when explicit sizes attributes are configured.
 */
add_filter('wp_img_tag_add_auto_sizes', '__return_false');


/**
 * Automatically replace dynamic placeholders like %currentyear% in frontend titles, excerpts and content
 */
function vld_parse_frontend_dynamic_tags($text) {
    if (!is_string($text) || false === strpos($text, '%')) {
        return $text;
    }
    return str_replace(
        ['%currentyear%', '%currentmonth%', '%currentdate%'],
        [date('Y'), date('m'), date('d/m/Y')],
        $text
    );
}
add_filter('the_title', 'vld_parse_frontend_dynamic_tags', 20);
add_filter('the_excerpt', 'vld_parse_frontend_dynamic_tags', 20);
add_filter('get_the_excerpt', 'vld_parse_frontend_dynamic_tags', 20);
add_filter('the_content', 'vld_parse_frontend_dynamic_tags', 20);
