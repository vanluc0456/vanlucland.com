        '/contact' => '/lien-he/',
        '/about-us' => '/gioi-thieu/',
        '/thanh-toan' => '/lien-he/',
        '/reset-password' => '/lien-he/',
        '/tim-du-an' => '/du-an/',
        '/wellness-second-home-la-gi' => '/tin-tuc/',
        '/anh-thi-truong-bds-dang-bi-gioi-sieu-giau-thao-tung-ra-sao' => '/tin-tuc/',
        '/nhung-chieu-tro-du-mua-nha-dat-khach-sap-bay-lo-nang-ban-lo' => '/tin-tuc/',
