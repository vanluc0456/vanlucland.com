        'email'        => vld_option('email', 'vanlucland@gmail.com'),
        'priceRange'   => '$$$',
        'openingHours' => vld_option('opening_hours', 'Mo-Su 00:00-23:59'),
        'sameAs'       => array(
            'https://www.facebook.com/vanlucland',
            'https://www.youtube.com/@vanlucland',
            'https://www.linkedin.com/company/vanlucland',
            'https://twitter.com/vanlucland',
            'https://www.pinterest.com/vanlucland',
            'https://zalo.me/0932032111',
            'https://en.wikialpha.org/wiki/V%C4%83n_L%E1%BB%B1c_Land',
        ),
        'address'      => array(
            '@type'           => 'PostalAddress',
            'streetAddress'   => vld_option('address', '105 Nguyễn Công Trứ , Q.1, TP.HCM'),
            'addressLocality' => 'TP. Hồ Chí Minh',
            'addressRegion'   => 'TP. Hồ Chí Minh',
            'addressCountry'  => 'VN',
        ),
        'geo'          => array(
            '@type'     => 'GeoCoordinates',
            'latitude'  => (float) vld_option('geo_latitude', '10.7743'),
            'longitude' => (float) vld_option('geo_longitude', '106.7031'),
        ),
        'areaServed'   => array(
            array(
                '@type' => 'AdministrativeArea',
                'name'  => 'TP. Hồ Chí Minh',
                '@id'   => 'https://www.wikidata.org/wiki/Q1803',
            ),
            array(
                '@type' => 'AdministrativeArea',
                'name'  => 'TP. Thủ Đức',
                '@id'   => 'https://www.wikidata.org/wiki/Q104193856',
            ),
            array(
                '@type' => 'AdministrativeArea',
                'name'  => 'Khu Nam Sài Gòn (Quận 7, Nhà Bè, Bình Chánh)',
            ),
        ),
        'knowsAbout'   => array(
            array(
                '@type'  => 'Thing',
                'name'   => 'Bất động sản',
                'sameAs' => 'https://vi.wikipedia.org/wiki/B%E1%BA%A5t_%C4%91%E1%BB%99ng_s%E1%BA%A3n',
            ),
            array(
                '@type'  => 'Place',
                'name'   => 'TP. Hồ Chí Minh',
                'sameAs' => 'https://www.wikidata.org/wiki/Q1803',
            ),
            array(
                '@type'  => 'Place',
                'name'   => 'TP. Thủ Đức',
                'sameAs' => 'https://www.wikidata.org/wiki/Q104193856',
            ),
            array(
                '@type'  => 'Place',
                'name'   => 'Khu đô thị Nam Sài Gòn',
                'sameAs' => 'https://vi.wikipedia.org/wiki/Khu_%C4%91%C3%B4_th%E1%BB%8B_Nam_S%C3%A0i_G%C3%B2n',
            ),
            array(
                '@type'  => 'Thing',
                'name'   => 'Thẩm định giá và Đầu tư Bất động sản',
                'sameAs' => 'https://www.wikidata.org/wiki/Q6507412',
            ),
        ),
        'founder'      => array(
            '@type'    => 'Person',
            'name'     => 'Văn Lực',
            'url'      => home_url('/gioi-thieu/'),
            'jobTitle' => 'Chuyên gia tư vấn Bất động sản cao cấp',
        ),
    );

    $logo_id = get_theme_mod('custom_logo');
    if ($logo_id) {
        $logo_url = wp_get_attachment_image_url($logo_id, 'full');
        if ($logo_url) {
            $schema['logo'] = array(
                '@type' => 'ImageObject',
                'url'   => $logo_url,
            );
