// Add Interactive Loan Calculator for Article 1715
function vld_article_loan_calculator_script() {
    if (!is_singular()) return;
    ?>
    <script>
    function artFormat(n){ return new Intl.NumberFormat("vi-VN").format(Math.round(n)) + " đ"; }
    function artCalculate(){
        var pElem = document.getElementById("art-price");
        if (!pElem) return;
        var p = parseFloat(pElem.value) || 3000000000;
        var r = parseFloat(document.getElementById("art-ratio").value) || 70;
        var y = parseFloat(document.getElementById("art-years").value) || 20;
        var promoRate = (parseFloat(document.getElementById("art-rate-promo").value) || 0) / 100;
        var promoMonths = parseInt(document.getElementById("art-promo-months").value, 10);
        var floatingRate = (parseFloat(document.getElementById("art-rate-floating").value) || 9.5) / 100;
        var hasGrace = true;

        document.getElementById("art-val-price").innerText = artFormat(p);
        document.getElementById("art-val-ratio").innerText = r + "%";
        document.getElementById("art-val-years").innerText = y + " năm (" + (y*12) + " tháng)";

        var loan = p * (r/100);
        var down = p - loan;
        var totalMonths = y * 12;

        var promoPrincipal = hasGrace ? 0 : (loan / totalMonths);
        var promoInterest = loan * (promoRate / 12);
        var promoMonthly = promoPrincipal + promoInterest;

        var remainingMonths = totalMonths - promoMonths;
        if (remainingMonths <= 0) remainingMonths = totalMonths;
        var postPromoPrincipal = loan / remainingMonths;
        var postPromoInterestFirst = loan * (floatingRate / 12);
        var postPromoMonthly = postPromoPrincipal + postPromoInterestFirst;

        document.getElementById("art-res-down").innerText = artFormat(down);
        document.getElementById("art-res-loan").innerText = artFormat(loan);

        var labelP = document.getElementById("art-label-promo");
        var resP = document.getElementById("art-res-monthly-promo");
        var subP = document.getElementById("art-sub-promo");

        if (promoMonths > 0) {
            if(labelP) labelP.innerText = "GIAI ĐOẠN 1 (" + promoMonths + " THÁNG ĐẦU):";
            if(resP) resP.innerText = (promoMonthly === 0 ? "0 đ/tháng" : artFormat(promoMonthly) + "/tháng");
            if(subP) subP.innerText = (promoRate === 0 ? "(Lãi suất 0% & Ân hạn nợ gốc)" : "(Lãi suất ưu đãi " + (promoRate*100).toFixed(1) + "%/năm)");
        } else {
            if(labelP) labelP.innerText = "TRẢ GỐC + LÃI THÁNG ĐẦU:";
            if(resP) resP.innerText = artFormat(postPromoMonthly) + "/tháng";
            if(subP) subP.innerText = "(Không áp dụng ưu đãi)";
        }

        var resF = document.getElementById("art-res-monthly-floating");
        if(resF) resF.innerText = artFormat(postPromoMonthly) + "/tháng";
    }
    document.addEventListener("DOMContentLoaded", function(){ if(document.getElementById("art-price")) artCalculate(); });
    if(document.getElementById("art-price")) artCalculate();
    </script>
    <?php
}
add_action('wp_footer', 'vld_article_loan_calculator_script', 50);
// Google Analytics 4 & Google Tag Manager Integration Engine
function vld_google_analytics_head() {
    $ga4_id = vld_option('ga4_measurement_id', '');
    $gtm_id = vld_option('gtm_container_id', '');

    if (!empty($gtm_id)) {
        ?>
        <!-- Google Tag Manager: load after genuine user interaction. -->
        <script>(function(w,d,i){
        w.dataLayer=w.dataLayer||[];w.dataLayer.push({'gtm.start':Date.now(),event:'gtm.js'});
        var loaded=false,load=function(){if(loaded)return;loaded=true;var s=d.createElement('script');
        s.async=true;s.src='https://www.googletagmanager.com/gtm.js?id='+encodeURIComponent(i);d.head.appendChild(s);};
        ['pointerdown','touchstart','scroll','keydown'].forEach(function(e){w.addEventListener(e,load,{once:true,passive:true});});
        })(window,document,'<?php echo esc_js($gtm_id); ?>');</script>
        <?php
    } elseif (!empty($ga4_id)) {
        ?>
        <!-- Google tag: queue configuration now, fetch the library on interaction. -->
        <script>(function(w,d,i){
        w.dataLayer=w.dataLayer||[];w.gtag=w.gtag||function(){w.dataLayer.push(arguments);};
        w.gtag('js',new Date());w.gtag('config',i);
        var loaded=false,load=function(){if(loaded)return;loaded=true;var s=d.createElement('script');
        s.async=true;s.src='https://www.googletagmanager.com/gtag/js?id='+encodeURIComponent(i);d.head.appendChild(s);};
        ['pointerdown','touchstart','scroll','keydown'].forEach(function(e){w.addEventListener(e,load,{once:true,passive:true});});
        })(window,document,'<?php echo esc_js($ga4_id); ?>');</script>
        <?php
    }
}
add_action('wp_head', 'vld_google_analytics_head', 1);


