// ==========================================================================
// AUTOMATED HIGH-CONVERTING SEO TITLE & META DESCRIPTION FOR ALL PROJECTS
// ==========================================================================
add_filter('rank_math/frontend/title', 'vld_auto_project_seo_title', 99);
function vld_auto_project_seo_title($title) {
    if (is_singular('du_an')) {
        $post_id = get_the_ID();
        $custom_title = get_post_meta($post_id, 'rank_math_title', true);
        if (!empty($custom_title)) {
            return class_exists('RankMath\Helper') ? \RankMath\Helper::replace_vars($custom_title, get_post($post_id)) : $custom_title;
        }

        $raw_title = get_the_title($post_id);
        $clean_title = preg_replace('/^(Dự\s*án\s*căn\s*hộ|Dự\s*án|Căn\s*hộ)\s+/iu', '', $raw_title);
        $clean_title = preg_replace('/[:\-–|].*$/iu', '', $clean_title);
        $clean_title = trim($clean_title);

        $location = get_post_meta($post_id, '_vld_location', true);
        $district = '';
        if ($location && preg_match('/(Quận\s*\d+|Nhà\s*Bè|Bình\s*Chánh|Thủ\s*Đức|Bình\s*Thạnh|Tân\s*Bình)/iu', $location, $m)) {
            $district = ' ' . $m[1];
        }

        $current_year = wp_date('Y');
        return "Dự Án {$clean_title}{$district}: Bảng Giá & Thông Tin {$current_year}";
    }
    return $title;
}

add_filter('rank_math/frontend/description', 'vld_auto_project_seo_description', 99);
function vld_auto_project_seo_description($desc) {
    if (is_singular('du_an')) {
        $post_id = get_the_ID();
        $custom_desc = get_post_meta($post_id, 'rank_math_description', true);
        if (!empty($custom_desc)) {
            return class_exists('RankMath\Helper') ? \RankMath\Helper::replace_vars($custom_desc, get_post($post_id)) : $custom_desc;
        }

        $raw_title = get_the_title($post_id);
        $clean_title = preg_replace('/^(Dự\s*án\s*căn\s*hộ|Dự\s*án|Căn\s*hộ)\s+/iu', '', $raw_title);
        $clean_title = preg_replace('/[:\-–|].*$/iu', '', $clean_title);
        $clean_title = trim($clean_title);

        $location = get_post_meta($post_id, '_vld_location', true) ?: 'TP.HCM';
        $price = get_post_meta($post_id, '_vld_price', true) ?: 'giá tốt';

        return "Thông tin dự án {$clean_title} tại {$location}: giá tham khảo {$price}, vị trí, mặt bằng, pháp lý và tiến độ. Kiểm tra dữ liệu mới trước khi giao dịch.";
    }
    return $desc;
}

/**
 * Keep search snippets concise and provide factual fallbacks for the few
 * taxonomy hubs that do not yet have an editorial description in Rank Math.
 */
function vld_normalize_search_description($description) {
    if (is_category() || is_tax()) {
        $term = get_queried_object();
        $fallbacks = array(
            'tai-chinh-lai-suat' => 'Cập nhật lãi suất vay mua nhà, cách tính dòng tiền, lịch trả nợ và các lưu ý khi so sánh gói vay ngân hàng dành cho người mua bất động sản.',
            'dat-nen-du-an'      => 'Danh sách và phân tích dự án đất nền: vị trí, quy hoạch, pháp lý, tiến độ hạ tầng, giá tham khảo và các hồ sơ cần kiểm tra trước khi giao dịch.',
            'du-an-moi'          => 'Tổng hợp dự án bất động sản mới được Văn Lực Land theo dõi, kèm thông tin vị trí, sản phẩm, tiến độ, pháp lý và giá tham khảo theo từng thời điểm.',
        );
        if (
            (!$description || '' === trim(wp_strip_all_tags((string) $description)))
            && $term instanceof WP_Term
            && isset($fallbacks[$term->slug])
        ) {
            $description = $fallbacks[$term->slug];
        }
    }

    $description = trim(preg_replace('/\s+/u', ' ', html_entity_decode(wp_strip_all_tags((string) $description), ENT_QUOTES | ENT_HTML5, 'UTF-8')));
    if (function_exists('mb_strlen') && mb_strlen($description, 'UTF-8') > 160) {
        $description = wp_html_excerpt($description, 157, '…');
    } elseif (strlen($description) > 160) {
        $description = wp_html_excerpt($description, 157, '…');
    }

    return $description;
}
add_filter('rank_math/frontend/description', 'vld_normalize_search_description', 999);


