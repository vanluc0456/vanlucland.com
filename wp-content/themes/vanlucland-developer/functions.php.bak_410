}

/**
 * Keep the project type selector deliberately single-purpose. Legacy display
 * terms stay in the database for safety but are not mixed into this control.
 */
function vld_project_type_meta_box($post, $box) {
    $taxonomy = $box['args']['taxonomy'] ?? 'danh_muc_du_an';
    $selected = wp_get_object_terms($post->ID, $taxonomy, array('fields' => 'ids'));
    $selected = is_wp_error($selected) ? array() : array_map('intval', $selected);

    wp_nonce_field('taxonomy_' . $taxonomy, 'taxonomy_noncename');
    ?>
    <div class="vld-project-type-box">
        <p style="margin:0 0 10px;color:#50575e;">
            <?php esc_html_e('Chọn một loại hình chính để lọc dự án ngoài website.', 'vanlucland-developer'); ?>
        </p>
        <input type="hidden" name="tax_input[<?php echo esc_attr($taxonomy); ?>][]" value="0">
        <?php foreach (vld_project_type_definitions() as $legacy_value => $definition) : ?>
            <?php
            $term = get_term_by('slug', $definition['term_slug'], $taxonomy);
            if (!$term) {
                $term = get_term_by('name', $definition['name'], $taxonomy);
            }
            if (!$term || is_wp_error($term)) {
                continue;
            }
            ?>
            <p style="margin:8px 0;">
                <label for="vld-project-type-<?php echo esc_attr($term->term_id); ?>">
                    <input
                        id="vld-project-type-<?php echo esc_attr($term->term_id); ?>"
                        type="radio"
                        name="tax_input[<?php echo esc_attr($taxonomy); ?>][]"
                        value="<?php echo esc_attr($term->term_id); ?>"
                        <?php checked(in_array((int) $term->term_id, $selected, true)); ?>
                    >
                    <?php echo esc_html($definition['name']); ?>
                </label>
            </p>
        <?php endforeach; ?>
    </div>
    <?php
}

/**
 * Resolve the canonical front-end filter value from the taxonomy first, then
 * fall back to the legacy _vld_type meta used by older theme releases.
 */
function vld_get_project_filter_type($post_id) {
    $definitions = vld_project_type_definitions();
    $terms       = wp_get_object_terms(absint($post_id), 'danh_muc_du_an');

    if (!is_wp_error($terms)) {
        foreach ($terms as $term) {
            foreach ($definitions as $legacy_value => $definition) {
                if ($term->slug === $definition['term_slug'] || $term->name === $definition['name']) {
                    return $legacy_value;
                }
            }
        }
    }

    $legacy_value = get_post_meta(absint($post_id), '_vld_type', true);
    return isset($definitions[$legacy_value]) ? $legacy_value : '';
}

function vld_get_project_type_label($post_id) {
    $type        = vld_get_project_filter_type($post_id);
    $definitions = vld_project_type_definitions();
    return isset($definitions[$type]) ? $definitions[$type]['name'] : '';
}

/**
 * Seed only real project types and migrate old signals without deleting any
 * posts, terms, relationships or meta values.
 */
function vld_maybe_seed_default_project_terms() {
    if (VLD_VERSION === get_option('vld_data_version')) {
        return;
    }

    vld_register_project_cpt();

    foreach (vld_project_type_definitions() as $definition) {
        if (!term_exists($definition['name'], 'danh_muc_du_an')) {
            wp_insert_term(
                $definition['name'],
                'danh_muc_du_an',
                array('slug' => $definition['term_slug'])
            );
        }
    }

    $project_ids = get_posts(
        array(
            'post_type'              => 'du_an',
            'post_status'            => array('publish', 'draft', 'pending', 'private'),
            'posts_per_page'         => -1,
            'fields'                 => 'ids',
            'no_found_rows'          => true,
            'update_post_meta_cache' => true,
            'update_post_term_cache' => true,
        )
    );

    foreach ($project_ids as $project_id) {
        $legacy_type = get_post_meta($project_id, '_vld_type', true);
        $definitions = vld_project_type_definitions();
        $project_terms = wp_get_object_terms($project_id, 'danh_muc_du_an');
        $has_canonical_type = false;

        if (!is_wp_error($project_terms)) {
            foreach ($project_terms as $project_term) {
                foreach ($definitions as $definition) {
                    if (
                        $project_term->slug === $definition['term_slug']
                        || $project_term->name === $definition['name']
                    ) {
                        $has_canonical_type = true;
                        break 2;
                    }
                }
            }
        }

        if (isset($definitions[$legacy_type]) && !$has_canonical_type) {
            wp_set_object_terms(
                $project_id,
                $definitions[$legacy_type]['term_slug'],
                'danh_muc_du_an',
                true
            );
        }

        if (has_term('Dự án Nổi bật Trang chủ', 'danh_muc_du_an', $project_id)) {
            update_post_meta($project_id, '_vld_show_featured', '1');
        }
        if (
            has_term('Dự án Mới', 'danh_muc_du_an', $project_id)
            && !get_post_meta($project_id, '_vld_badge', true)
        ) {
            update_post_meta($project_id, '_vld_badge', 'badge-new');
        }
    }

    update_option('vld_data_version', VLD_VERSION, false);
}
add_action('admin_init', 'vld_maybe_seed_default_project_terms');

/**
 * Keep the old _vld_type filter key synchronized when a project type changes.
 */
function vld_sync_project_type_legacy_meta($object_id, $terms, $tt_ids, $taxonomy) {
    if ('danh_muc_du_an' !== $taxonomy || 'du_an' !== get_post_type($object_id)) {
        return;
    }

    $resolved_type = '';
    $assigned_terms = wp_get_object_terms(absint($object_id), 'danh_muc_du_an');
    if (!is_wp_error($assigned_terms)) {
        foreach ($assigned_terms as $assigned_term) {
            foreach (vld_project_type_definitions() as $legacy_value => $definition) {
                if (
                    $assigned_term->slug === $definition['term_slug']
                    || $assigned_term->name === $definition['name']
                ) {
                    $resolved_type = $legacy_value;
                    break 2;
                }
            }
        }
    }

    if ($resolved_type) {
        update_post_meta($object_id, '_vld_type', $resolved_type);
    } else {
        delete_post_meta($object_id, '_vld_type');
    }
}
add_action('set_object_terms', 'vld_sync_project_type_legacy_meta', 10, 4);

