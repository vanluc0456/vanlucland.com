if (!defined('ABSPATH')) exit;

define('VLD_VERSION', '2.1.8');
define('VLD_ASSET_VERSION', '2.1.16');
define('VLD_DIR', get_template_directory());
define('VLD_URI', get_template_directory_uri());

require_once VLD_DIR . '/inc/hybrid-editor.php';
require_once VLD_DIR . '/inc/seo-content-tools.php';
require_once VLD_DIR . '/inc/vld-leads-manager.php';
require_once VLD_DIR . '/inc/google-indexing-controls.php';
