        '/co-nen-mua-nha-pho-the-classia-khang-dien-2026' => '/du-an/the-classia-khang-dien-thu-duc/',
                                        '/phap-ly-celesta-gold-nha-be-so-hong-giay-phep-2026' => '/phap-ly-celesta-gold-nha-be-so-hong-giay-phep/',
        '/phap-ly-tien-do-boi-thuong-gpmb-vinhomes-phuoc-vinh-tay-2026' => '/phap-ly-tien-do-boi-thuong-gpmb-vinhomes-phuoc-vinh-tay/',
