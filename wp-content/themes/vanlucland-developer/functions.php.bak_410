        '/du-an-the-apus-phuoc-hai-ba-ria-vung-tau-2' => '/du-an/',
        '/category/2403' => '/quy-hoach/',

        // Newly consolidated March/September 2026 legacy URLs & 404 elimination
        '/du-an/celesta-gold-nha-be' => '/du-an/can-ho-celesta-gold/',
        '/du-an/can-ho-tt-genesis-thong-tin-tt-capital-2' => '/du-an/du-an-tt-genesis-dao-su-tich-nha-be-bang-gia-uu-dai/',
        '/huong-dan-bang-tinh-lai-suat-vay-mua-nha-2026-2' => '/huong-dan-bang-tinh-lai-suat-vay-mua-nha/',
        '/du-an-can-ho-biet-thu-the-apus-phuoc-hai' => '/du-an/',
        '/du-an-an-lake-villas' => '/du-an/',
        '/du-an-can-ho-bcons-bee' => '/du-an/',
        '/du-an-can-ho-d-aqua' => '/du-an/',
        '/du-an-can-ho-the-myra-tan-hung' => '/du-an/',
        '/du-an-can-ho-dich-vu-334-luy-ban-bic' => '/du-an/',
        '/dat-nen-kinh-duong-vuong-binh-tan' => '/du-an/',
        '/du-an-long-phat-residence-dat-nen-san-bay-long-thanh' => '/du-an/',
