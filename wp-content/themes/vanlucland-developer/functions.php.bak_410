add_filter('wp_img_tag_add_loading_attr', 'vld_bypass_lazyload_hero_lcp', 10, 3);
function vld_bypass_lazyload_hero_lcp($value, $image, $context) {
    if (strpos($image, 'no-lazy') !== false || strpos($image, 'vld-hero-lcp-img') !== false) {
        return false; // Disable lazyload for Hero LCP
