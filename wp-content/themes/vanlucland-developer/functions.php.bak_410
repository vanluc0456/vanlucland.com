        '/tien-do-celesta-gold-nha-be-cap-nhat-xay-dung-2026' => '/tien-do-celesta-gold-nha-be-cap-nhat-xay-dung/',
        '/dau-tu-celesta-gold-nha-be-co-loi-khong-phan-tich-2026' => '/dau-tu-celesta-gold-nha-be-co-loi-khong-phan-tich/',
                '/du-an/du-an-hiep-phuoc-premia-long-an' => '/du-an/dat-nen-hiep-phuoc-premia-nha-be/',
