// =====================================================
// 1. Theme Setup & Gutenberg Hybrid Support
// =====================================================
function vld_theme_setup() {
    add_theme_support('title-tag');
    add_theme_support('post-thumbnails');
    add_theme_support('automatic-feed-links');
    add_theme_support('custom-logo', array(
        'height' => 80,
        'width' => 200,
        'flex-height' => true,
        'flex-width' => true,
    ));
    add_theme_support('html5', array('search-form', 'comment-form', 'comment-list', 'gallery', 'caption'));
    
    add_theme_support('align-wide');
    add_theme_support('responsive-embeds');
    add_theme_support('editor-styles');
    add_theme_support('appearance-tools');
    add_theme_support('custom-spacing');
    add_editor_style('assets/css/editor.css');

    /*
     * A project card is full-width on narrow phones and two/three columns
     * elsewhere. 768px is large enough for Lighthouse's mobile DPR while
     * avoiding the original 1100px+ upload on a roughly 400px card.
     */
    add_image_size('vld-project-card', 480, 300, true);
    add_image_size('vld-project-card-mobile', 240, 150, true);
    add_image_size('vld-news-thumb', 120, 80, true);
    add_image_size('vld-sidebar-thumb', 50, 50, true);

    register_nav_menus(array(
        'primary' => __('Menu Chính', 'vanlucland-developer'),
        'mobile'  => __('Menu Mobile', 'vanlucland-developer'),
    ));
}
add_action('after_setup_theme', 'vld_theme_setup');

// =====================================================
// 2. Enqueue Scripts & Styles
// =====================================================
function vld_enqueue_assets() {
    wp_enqueue_style('vld-icons', VLD_URI . '/assets/css/icons.min.css', array(), VLD_ASSET_VERSION);
    $use_home_critical_css = is_front_page();
    if ($use_home_critical_css) {
        wp_enqueue_style('vld-home-optimized', VLD_URI . '/assets/css/home-optimized.min.css', array(), VLD_ASSET_VERSION);
    } else {
        wp_enqueue_style('vld-style', VLD_URI . '/style.min.css', array(), VLD_ASSET_VERSION);
        wp_enqueue_style('vld-real-estate', VLD_URI . '/assets/css/real-estate-sales.css', array('vld-style'), VLD_ASSET_VERSION);
    }

    /* Native anchor scrolling avoids synchronous layout reads in JavaScript. */
    wp_add_inline_style('vld-real-estate', 'html{scroll-padding-top:90px}@media(max-width:767px){html{scroll-padding-top:72px}}');

    /*
     * Keep the content-integrity patch inline as well as in the source CSS.
     * LiteSpeed can retain an optimized CSS artifact after a theme file update;
     * this small, ordered fallback prevents stale UCSS from clipping live text.
     */
    wp_add_inline_style(
        'vld-real-estate',
        '.project-card .card-meta{height:auto!important;min-height:58px!important;justify-content:flex-start!important;overflow:visible!important}.project-card .card-meta>span{width:100%!important;min-width:0!important;max-width:100%!important;line-height:1.4!important}.project-card .card-meta>.card-location,.project-card .card-meta>span:first-child:not(:last-child){display:-webkit-box!important;white-space:normal!important;overflow:hidden!important;overflow-wrap:anywhere!important;text-overflow:clip!important;-webkit-box-orient:vertical!important;-webkit-line-clamp:2!important}.project-card .card-meta>.card-area,.project-card .card-meta>span:last-child:not(:first-child){white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important}@media(max-width:768px){.single-project-page .project-hero-grid{overflow:visible!important}.single-project-page .project-hero-grid>.project-gallery-box,.single-project-page .project-hero-grid>.project-specs-box,.single-project-page .project-gallery-box>*,.single-project-page .project-specs-box>*{width:auto!important;min-width:0!important;max-width:100%!important;box-sizing:border-box!important}}'
    );

    /* Keep the cloned partner marquee on one row on narrow screens. */
    wp_add_inline_style(
        'vld-real-estate',
        '@media(max-width:768px){#partners-slider{flex-wrap:nowrap!important;justify-content:flex-start!important;height:auto!important;overflow:visible!important}#partners-slider>.partner-card{width:145px!important;min-width:145px!important;max-width:145px!important;height:54px!important;flex:0 0 145px!important;margin:0!important;padding:8px 18px!important;overflow:visible!important}}'
    );

    /* Bypass stale LiteSpeed UCSS for the compact mobile footer layout. */
    wp_add_inline_style(
        'vld-real-estate',
        '@media(max-width:575px){#colophon .footer-compact-grid{grid-template-columns:minmax(0,1fr) minmax(0,1fr)!important;column-gap:16px!important;row-gap:10px!important;padding-bottom:8px!important}#colophon .footer-col-brand,#colophon .footer-col-contact{grid-column:1/-1!important}#colophon .footer-col-nav .footer-nav-list a{min-height:32px!important;padding:4px 0!important;line-height:24px!important}#colophon .footer-col-contact a{min-height:28px!important;padding:2px 0!important}#colophon .footer-bottom-bar-light{padding:6px 0!important}}'
    );

    /* Keep the mobile hero text transparent; only the full-image gradient remains. */
    wp_add_inline_style(
        'vld-real-estate',
        '@media(max-width:575px){#hero .slide-content,#hero .hero-slide-content{background:transparent!important;backdrop-filter:none!important;-webkit-backdrop-filter:none!important;box-shadow:none!important;border:none!important}}'
    );


    // Keep long-form articles readable while using the full main column.
    wp_add_inline_style('vld-real-estate', '.single-post .bds8-article-body{max-width:100% !important;margin-inline:0 !important;font-size:17px !important;line-height:1.7 !important;}.single-post .bds8-article-body>p{margin:0 0 16px !important;line-height:1.7 !important;}.single-post .bds8-article-body>h2{font-size:clamp(23px,2.2vw,27px) !important;line-height:1.35 !important;margin:30px 0 12px !important;}.single-post .bds8-article-body>h3{font-size:clamp(19px,1.8vw,22px) !important;line-height:1.4 !important;margin:24px 0 9px !important;}.single-post .bds8-article-body>h4{font-size:17px !important;line-height:1.4 !important;margin:20px 0 7px !important;}.single-post .bds8-article-body>ul,.single-post .bds8-article-body>ol{margin:6px 0 16px 1.4em !important;line-height:1.6 !important;}.single-post .bds8-article-body>ul>li,.single-post .bds8-article-body>ol>li{margin-bottom:6px !important;line-height:1.6 !important;}@media(max-width:767px){.single-post .bds8-article-body{font-size:16px !important;line-height:1.65 !important;}.single-post .bds8-article-body>p{margin-bottom:14px !important;line-height:1.65 !important;}.single-post .bds8-article-body>h2{font-size:22px !important;margin:26px 0 10px !important;}.single-post .bds8-article-body>h3{font-size:19px !important;margin:21px 0 8px !important;}.single-post .bds8-article-body>h4{font-size:16px !important;margin:18px 0 6px !important;}}');
    wp_add_inline_style('vld-real-estate', '.entry-content a:not(.btn),#vld-toc-toggle-btn{color:#0369a1 !important}.advisor-online-badge{background:#047857 !important;color:#fff !important}.advisor-role-badge{color:#075985 !important}.vld-author-card p:last-child,.res-mini-card:last-child .res-val{color:#0369a1 !important}.res-highlight small{color:#047857 !important}#res-loan-amount{color:#0f2c59 !important}#sub-promo-phase{color:#334155 !important}.vld-support-heading{margin:20px 0 8px;color:#0f2c59;font-weight:800;line-height:1.4}.single-project-page .single-entry-content,.single-project-page .single-entry-content p{font-size:16px !important;line-height:1.65 !important}.single-project-page .single-entry-content p{margin-bottom:14px !important}.single-project-page .single-entry-content h2{font-size:22px !important;line-height:1.35 !important;margin:26px 0 10px !important}.single-project-page .single-entry-content h3{font-size:19px !important;line-height:1.4 !important;margin:21px 0 8px !important}@media(min-width:768px){.single-project-page .single-entry-content,.single-project-page .single-entry-content p{font-size:17px !important;line-height:1.7 !important}.single-project-page .single-entry-content h2{font-size:clamp(23px,2.2vw,27px) !important}.single-project-page .single-entry-content h3{font-size:clamp(19px,1.8vw,22px) !important}}');

    wp_enqueue_script('vld-main', VLD_URI . '/assets/js/main.min.js', array(), VLD_ASSET_VERSION, true);
    wp_script_add_data('vld-main', 'strategy', 'defer');

    wp_localize_script('vld-main', 'vldData', array(
        'ajaxUrl' => admin_url('admin-ajax.php'),
        'nonce'   => wp_create_nonce('vld_nonce'),
    ));
}
add_action('wp_enqueue_scripts', 'vld_enqueue_assets');

/**
 * Font Awesome is decorative and does not define layout. Load it without
 * blocking first paint; keep a noscript fallback for crawlers and no-JS users.
 */
function vld_async_icon_stylesheet($html, $handle, $href, $media) {
    if ('vld-icons' !== $handle) {
        return $html;
    }

    return sprintf(
        '<link rel="stylesheet" id="%1$s-css" href="%2$s" media="print" onload="this.media=\'all\'"><noscript><link rel="stylesheet" href="%2$s"></noscript>' . "\n",
        esc_attr($handle),
        esc_url($href)
    );
}
add_filter('style_loader_tag', 'vld_async_icon_stylesheet', 10, 4);

/**
 * Add connection hints only for third parties that are actually present.
 * The theme intentionally does not connect to Google Fonts, FontAwesome CDN
 * or Unsplash, so no unused preconnects are emitted for those origins.
 */
function vld_resource_hints($urls, $relation_type) {
    $scripts = wp_scripts();
    $origins = array();

    foreach ((array) $scripts->queue as $handle) {
        if (empty($scripts->registered[$handle]->src)) {
            continue;
        }

        $src  = (string) $scripts->registered[$handle]->src;
        $host = wp_parse_url($src, PHP_URL_HOST);
        if ($host) {
            $origins[$host] = 'https://' . $host;
        }
    }

    if ('dns-prefetch' === $relation_type) {
        foreach ($origins as $host => $origin) {
            $urls[] = '//' . $host;
        }
    }

    return array_values(array_unique($urls, SORT_REGULAR));
}
add_filter('wp_resource_hints', 'vld_resource_hints', 10, 2);

// =====================================================
// 2b. Agent discovery and accessibility
// =====================================================

/**
 * Escape a title for use as Markdown link text in llms.txt.
 */
function vld_llms_markdown_text($text) {
    $text = html_entity_decode(wp_strip_all_tags((string) $text), ENT_QUOTES, get_bloginfo('charset'));
    $text = preg_replace('/\s+/u', ' ', trim($text));

    return str_replace(array('\\', '[', ']'), array('\\\\', '\\[', '\\]'), $text);
}

/**
 * Add published content links to the llms.txt response.
 */
function vld_llms_content_links($post_type, $limit) {
    $links = array();
    $query = new WP_Query(array(
        'post_type'              => $post_type,
        'post_status'            => 'publish',
        'posts_per_page'         => absint($limit),
        'orderby'                => 'modified',
        'order'                  => 'DESC',
        'no_found_rows'          => true,
        'ignore_sticky_posts'    => true,
        'fields'                 => 'ids',
        'update_post_meta_cache' => false,
        'update_post_term_cache' => false,
    ));

    foreach ($query->posts as $post_id) {
        $title = vld_llms_markdown_text(get_the_title($post_id));
        $url   = get_permalink($post_id);

        if ($title && $url) {
            $links[] = '- [' . $title . '](' . esc_url_raw($url) . ')';
        }
    }

    return $links;
}

/**
 * Build the llms.txt Markdown document and retain a database-cache fallback.
 *
 * The public endpoint normally uses a physical file generated at the
 * WordPress root. The transient keeps the dynamic fallback inexpensive on
 * hosts that do not allow themes to create that file.
 */
function vld_get_llms_document($force_refresh = false) {
    $cache_key = 'vld_llms_document_v3';

    if (!$force_refresh) {
        $cached = get_transient($cache_key);
        if (is_string($cached) && '' !== $cached) {
            return $cached;
        }
    }

    $site_name   = vld_llms_markdown_text(get_bloginfo('name'));
    $description = vld_llms_markdown_text(get_bloginfo('description'));

    if (!$site_name) {
        $site_name = 'Văn Lực Land';
    }

    if (!$description) {
        $description = 'Thông tin dự án bất động sản, pháp lý, bảng giá và kiến thức thị trường tại TP.HCM cùng các khu vực lân cận.';
    }

    $contact_page = get_page_by_path('lien-he');
    $contact_url  = $contact_page ? get_permalink($contact_page) : home_url('/#lien-he');
    $lines        = array(
        '# ' . $site_name,
        '',
        '<!-- Generated by Văn Lực Land Developer; managed automatically. -->',
        '<!-- VLD llms.txt version: ' . VLD_VERSION . ' -->',
        '',
        '> ' . $description,
        '',
        '## Nội dung chính',
        '',
        '- [Trang chủ](' . esc_url_raw(home_url('/')) . ')',
        '- [Dự án đang phân phối](' . esc_url_raw(home_url('/du-an/')) . ')',
        '- [Tin tức bất động sản](' . esc_url_raw(home_url('/#tin-tuc')) . ')',
        '- [Liên hệ](' . esc_url_raw($contact_url) . ')',
        '',
    );

    $projects = vld_llms_content_links('du_an', 20);
    if ($projects) {
        $lines[] = '## Dự án mới cập nhật';
        $lines[] = '';
        $lines   = array_merge($lines, $projects, array(''));
    }

    $posts = vld_llms_content_links('post', 15);
    if ($posts) {
        $lines[] = '## Bài viết mới';
        $lines[] = '';
        $lines   = array_merge($lines, $posts, array(''));
    }

    $lines[] = '## Liên hệ';
    $lines[] = '';
    $lines[] = '- Hotline: ' . vld_llms_markdown_text(vld_option('hotline', '0932.032.111'));
    $lines[] = '- Email: ' . vld_llms_markdown_text(vld_option('email', 'vanlucland@gmail.com'));
    $lines[] = '- Website: ' . esc_url_raw(home_url('/'));
    $lines[] = '';

    $document = implode("\n", $lines);
    set_transient($cache_key, $document, 12 * HOUR_IN_SECONDS);

    return $document;
}

/**
 * Return the static llms.txt path when one installation owns the web root.
 */
function vld_llms_static_file_path() {
    if (is_multisite()) {
        return '';
    }

    return trailingslashit(ABSPATH) . 'llms.txt';
}

/**
 * Write a native static llms.txt file for sub-second agent access.
 *
 * An existing user-managed file is never overwritten. Only files containing
 * the theme marker are updated by later content or theme changes.
 */
function vld_write_static_llms_txt($force_refresh = false) {
    $path   = vld_llms_static_file_path();
    $marker = '<!-- Generated by Văn Lực Land Developer; managed automatically. -->';

    if ('' === $path) {
        return false;
    }

    clearstatcache(true, $path);

    if (is_file($path)) {
        $existing = file_get_contents($path); // phpcs:ignore WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents
        if (!is_string($existing) || false === strpos($existing, $marker) || !is_writable($path)) {
            return false;
        }
    } elseif (!is_writable(dirname($path))) {
        return false;
    }

    $document = vld_get_llms_document($force_refresh);
    $written  = file_put_contents($path, $document, LOCK_EX); // phpcs:ignore WordPress.WP.AlternativeFunctions.file_system_operations_file_put_contents

    if (false === $written || strlen($document) !== $written) {
        return false;
    }

    update_option('vld_llms_static_version', VLD_VERSION, false);
    delete_option('vld_llms_needs_refresh');
    delete_transient('vld_llms_static_write_failed');

    return true;
}

/**
 * Create or refresh the static file once after an update or content change.
 */
function vld_maybe_sync_static_llms_txt() {
    $path          = vld_llms_static_file_path();
    $needs_refresh = (bool) get_option('vld_llms_needs_refresh', false);
    $same_version  = VLD_VERSION === get_option('vld_llms_static_version');

    if ('' === $path || (!$needs_refresh && $same_version && is_file($path))) {
        return;
    }

    if (get_transient('vld_llms_static_write_failed')) {
        return;
    }

    if (!vld_write_static_llms_txt(true)) {
        set_transient('vld_llms_static_write_failed', '1', 6 * HOUR_IN_SECONDS);
    }
}
// Run after the Project post type is registered so project permalinks resolve.
add_action('init', 'vld_maybe_sync_static_llms_txt', 100);

/**
 * Invalidate generated content. The shutdown refresh ensures that a physical
 * file cannot remain stale merely because future /llms.txt requests bypass PHP.
 */
function vld_mark_llms_txt_stale($post_id = 0) {
    if (is_numeric($post_id) && 0 < (int) $post_id) {
        $post_id = (int) $post_id;
        if (wp_is_post_revision($post_id) || wp_is_post_autosave($post_id)) {
            return;
        }
    }

    delete_transient('vld_llms_document_v3');
    delete_transient('vld_llms_static_write_failed');
    update_option('vld_llms_needs_refresh', '1', true);
    $GLOBALS['vld_llms_needs_refresh_memory'] = true;
}
add_action('save_post_post', 'vld_mark_llms_txt_stale', 100, 1);
add_action('save_post_du_an', 'vld_mark_llms_txt_stale', 100, 1);
add_action('trashed_post', 'vld_mark_llms_txt_stale', 100, 1);
add_action('untrashed_post', 'vld_mark_llms_txt_stale', 100, 1);
add_action('deleted_post', 'vld_mark_llms_txt_stale', 100, 1);
add_action('customize_save_after', 'vld_mark_llms_txt_stale', 100, 0);
add_action('update_option_blogname', 'vld_mark_llms_txt_stale', 100, 0);
add_action('update_option_blogdescription', 'vld_mark_llms_txt_stale', 100, 0);

function vld_refresh_static_llms_txt_on_shutdown() {
    if (!empty($GLOBALS['vld_llms_needs_refresh_memory']) && !get_transient('vld_llms_static_write_failed')) {
        if (!vld_write_static_llms_txt(true)) {
            set_transient('vld_llms_static_write_failed', '1', 6 * HOUR_IN_SECONDS);
        }
        $GLOBALS['vld_llms_needs_refresh_memory'] = false;
    }
}
add_action('shutdown', 'vld_refresh_static_llms_txt_on_shutdown', 1);

/**
 * Serve a deterministic dynamic fallback when the static file cannot be made.
 *
 * Some WordPress/permalink combinations route /llms.txt to the front page.
 * Handling the path before redirects and template rendering guarantees that
 * AI agents get plain Markdown instead of a canonical or SEO redirect.
 */
function vld_maybe_serve_llms_txt() {
    if (is_admin()) {
        return;
    }

    $method = isset($_SERVER['REQUEST_METHOD']) ? strtoupper(sanitize_text_field(wp_unslash($_SERVER['REQUEST_METHOD']))) : 'GET';
    if (!in_array($method, array('GET', 'HEAD'), true)) {
        return;
    }

    $request_uri  = isset($_SERVER['REQUEST_URI']) ? wp_unslash($_SERVER['REQUEST_URI']) : '';
    $request_path = rawurldecode((string) wp_parse_url($request_uri, PHP_URL_PATH));
    $llms_path    = rawurldecode((string) wp_parse_url(home_url('/llms.txt'), PHP_URL_PATH));

    if (untrailingslashit($request_path) !== untrailingslashit($llms_path)) {
        return;
    }

    $document = vld_get_llms_document();
    $etag     = '"' . hash('sha256', $document) . '"';

    $if_none_match = isset($_SERVER['HTTP_IF_NONE_MATCH']) ? trim(sanitize_text_field(wp_unslash($_SERVER['HTTP_IF_NONE_MATCH']))) : '';
    if ($if_none_match && hash_equals($etag, $if_none_match)) {
        status_header(304);
        header('ETag: ' . $etag);
        header('Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=86400');
        exit;
    }

    status_header(200);
    header('Content-Type: text/plain; charset=' . get_option('blog_charset'));
    header('X-Content-Type-Options: nosniff');
    header('Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=86400');
    header('X-LiteSpeed-Cache-Control: public,max-age=86400');
    header('ETag: ' . $etag);

    if ('HEAD' !== $method) {
        echo $document; // phpcs:ignore WordPress.Security.EscapeOutput.OutputNotEscaped -- Plain-text Markdown assembled from escaped values.
    }
    exit;
}
// Run before Rank Math's redirection manager, which can exit before
// template_redirect. Keep template_redirect as a compatibility fallback.
add_action('parse_request', 'vld_maybe_serve_llms_txt', -1000, 0);
add_action('template_redirect', 'vld_maybe_serve_llms_txt', -20);

/**
 * Site Kit was loading its Ninja Forms event provider on the homepage even
 * though the homepage uses the theme's own form. Remove only that unused
 * provider; do not blanket-defer WordPress/plugin scripts because inline
 * dependencies can break when execution order changes.
 */
function vld_remove_unused_front_assets() {
    if (!is_front_page() || is_user_logged_in()) {
        return;
    }

    $scripts = wp_scripts();
    foreach ((array) $scripts->queue as $handle) {
        if (empty($scripts->registered[$handle]->src)) {
            continue;
        }

        $src = (string) $scripts->registered[$handle]->src;
        if (false !== strpos($src, 'googlesitekit-events-provider-ninja-forms')) {
            wp_dequeue_script($handle);
        }
    }
}
add_action('wp_enqueue_scripts', 'vld_remove_unused_front_assets', 999);

// Chỉ bỏ CSS block khi trang chủ đang dùng bố cục PHP cũ.
// Khi bật Hybrid Gutenberg, thư viện block được giữ lại để các block lõi không vỡ.
function vld_cleanup_bloat() {
    if (!is_admin() && is_front_page() && !vld_front_page_uses_hybrid_blocks()) {
        wp_dequeue_style('wp-block-library');
        wp_dequeue_style('wp-block-library-theme');
    }
}
add_action('wp_enqueue_scripts', 'vld_cleanup_bloat', 100);

function vld_cleanup_head() {
    remove_action('wp_head', 'print_emoji_detection_script', 7);
    remove_action('wp_print_styles', 'print_emoji_styles');
    remove_action('wp_head', 'rsd_link');
    remove_action('wp_head', 'wlwmanifest_link');
    remove_action('wp_head', 'wp_generator');
}
add_action('init', 'vld_cleanup_head');

