// their canonical destination instead of creating an avoidable redirect chain.
add_action('template_redirect', 'vld_redirect_verified_legacy_content', -9999);
add_action('parse_request', 'vld_redirect_verified_legacy_content', -9999);

/**
 * A physical file in the web root takes precedence over WordPress. Warn the
 * administrator instead of deleting a host-level file automatically.
 */
function vld_seo_file_conflict_notice() {
    if (!current_user_can('manage_options')) {
        return;
    }

    $conflicts = array();
    foreach (array('robots.txt', 'sitemap.xml') as $filename) {
        if (file_exists(ABSPATH . $filename)) {
            $conflicts[] = $filename;
        }
    }

    if (!$conflicts) {
        return;
    }

    echo '<div class="notice notice-warning"><p>';
    echo esc_html(
        sprintf(
            __('Văn Lực Land All-in-One: hãy xóa file vật lý cũ %s khỏi thư mục gốc website để WordPress dùng robots và sitemap động của theme.', 'vanlucland-developer'),
            implode(', ', $conflicts)
        )
    );
    echo '</p></div>';
}
add_action('admin_notices', 'vld_seo_file_conflict_notice');

