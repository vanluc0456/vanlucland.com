        '/danh-muc-du-an/bds-nghi-duong' => '/du-an/',
        '/sitemap.txt' => '/sitemap_index.xml',
    );

    if (isset($legacy_map[$lookup_path])) {
        wp_safe_redirect(home_url($legacy_map[$lookup_path]), 301, 'Văn Lực Land');
        exit;
    }

    // Pattern matching for legacy /bds/, /project/, /tinh-thanh/
    if (0 === strpos($lookup_path, '/bds/') || 0 === strpos($lookup_path, '/project/') || 0 === strpos($lookup_path, '/tinh-thanh/') || 0 === strpos($lookup_path, '/tinh-thanh-du-an/')) {
        wp_safe_redirect(home_url('/du-an/'), 301, 'Văn Lực Land');
        exit;
    }
}
