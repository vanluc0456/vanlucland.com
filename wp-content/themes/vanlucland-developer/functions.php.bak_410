add_action('customize_register', 'vld_customize_register');

function vld_sanitize_select($input, $setting) {
    $input   = sanitize_key($input);
    $control = $setting->manager->get_control($setting->id);
    $choices = $control ? (array) $control->choices : array();

    return array_key_exists($input, $choices) ? $input : $setting->default;
}

function vld_sanitize_range($input, $setting) {
    $input   = absint($input);
    $control = $setting->manager->get_control($setting->id);
    $attrs   = $control ? (array) $control->input_attrs : array();
    $min     = isset($attrs['min']) ? absint($attrs['min']) : 0;
    $max     = isset($attrs['max']) ? absint($attrs['max']) : 9999;

    return min($max, max($min, $input));
}

function vld_sanitize_footer_order($input) {
    $allowed = array('brand', 'projects', 'links', 'map');
    $items   = array_values(array_unique(array_filter(array_map('sanitize_key', explode(',', (string) $input)))));
    $items   = array_values(array_intersect($items, $allowed));

    foreach ($allowed as $item) {
        if (!in_array($item, $items, true)) {
            $items[] = $item;
        }
    }

    return implode(',', $items);
}

function vld_customize_controls_assets() {
    wp_enqueue_script(
        'vld-customizer-controls',
        VLD_URI . '/assets/js/customizer-controls.min.js',
        array('jquery', 'jquery-ui-sortable', 'customize-controls'),
        VLD_VERSION,
        true
    );

    wp_add_inline_style(
        'customize-controls',
        '.customize-control input[type=range]{width:calc(100% - 58px);vertical-align:middle}.vld-range-value{display:inline-grid;min-width:38px;min-height:32px;margin-left:8px;padding:0 6px;color:#1d2327;background:#fff;border:1px solid #8c8f94;border-radius:4px;font-weight:600;place-items:center;vertical-align:middle}.vld-sortable-list{margin:10px 0 0}.vld-sortable-item{display:flex;align-items:center;gap:7px;min-height:52px;margin:0 0 7px;padding:4px 12px 4px 4px;background:#fff;border:1px solid #c3c4c7;border-radius:4px;box-shadow:0 1px 1px rgba(0,0,0,.04)}.vld-sortable-handle{display:grid;min-width:44px;min-height:44px;color:#50575e;cursor:grab;place-items:center;touch-action:none}.vld-sortable-item.ui-sortable-helper{box-shadow:0 5px 14px rgba(0,0,0,.16)}'
    );
}
add_action('customize_controls_enqueue_scripts', 'vld_customize_controls_assets');

// 5. Helper function to get theme options (Auto fallback when empty)
function vld_option($key, $default = '') {
    $val = get_theme_mod('vld_' . $key, $default);
    return (!empty($val) && trim($val) !== '') ? $val : $default;
}

function vld_clamped_theme_mod($key, $default, $min, $max) {
    $value = absint(get_theme_mod($key, $default));
    return min($max, max($min, $value));
}

function vld_color_luminance($hex) {
    $hex = ltrim((string) $hex, '#');
    if (3 === strlen($hex)) {
        $hex = $hex[0] . $hex[0] . $hex[1] . $hex[1] . $hex[2] . $hex[2];
    }

    $channels = array(
        hexdec(substr($hex, 0, 2)) / 255,
        hexdec(substr($hex, 2, 2)) / 255,
        hexdec(substr($hex, 4, 2)) / 255,
    );

    foreach ($channels as &$channel) {
        $channel = ($channel <= 0.03928)
            ? $channel / 12.92
            : pow(($channel + 0.055) / 1.055, 2.4);
    }
    unset($channel);

    return (0.2126 * $channels[0]) + (0.7152 * $channels[1]) + (0.0722 * $channels[2]);
}

function vld_color_contrast($foreground, $background) {
    $lighter = max(vld_color_luminance($foreground), vld_color_luminance($background));
    $darker  = min(vld_color_luminance($foreground), vld_color_luminance($background));

    return ($lighter + 0.05) / ($darker + 0.05);
}

function vld_accessible_text_color($preferred, $backgrounds) {
    $backgrounds = (array) $backgrounds;
    $candidates  = array($preferred, '#FFFFFF', '#000000');
    $best        = '#FFFFFF';
    $best_score  = 0;

    foreach (array_unique($candidates) as $candidate) {
        $score = PHP_FLOAT_MAX;
        foreach ($backgrounds as $background) {
            $score = min($score, vld_color_contrast($candidate, $background));
        }

        if ($score >= 4.5) {
            return $candidate;
        }

        if ($score > $best_score) {
            $best       = $candidate;
            $best_score = $score;
        }
    }

    return $best;
}

function vld_footer_order() {
    return explode(',', vld_sanitize_footer_order(get_theme_mod('vld_footer_order', 'brand,projects,links,map')));
}

/**
 * Convert Customizer choices into scoped CSS. Numeric settings are clamped
 * again here so legacy database values cannot break the public layout.
 */
function vld_enqueue_design_customizations() {
    $contact_padding = vld_clamped_theme_mod('vld_contact_padding', 18, 0, 80);
    $contact_gap     = vld_clamped_theme_mod('vld_contact_gap', 18, 4, 60);
    $info_width      = vld_clamped_theme_mod('vld_contact_info_width', 38, 25, 55);
    $form_width      = 100 - $info_width;
    $heading_size    = vld_clamped_theme_mod('vld_contact_heading_size', 22, 16, 38);
    $form_padding    = vld_clamped_theme_mod('vld_contact_form_padding', 14, 4, 40);
    $form_radius     = vld_clamped_theme_mod('vld_contact_form_radius', 12, 0, 30);
    $footer_padding  = vld_clamped_theme_mod('vld_footer_padding', 10, 0, 80);
    $footer_gap      = vld_clamped_theme_mod('vld_footer_gap', 18, 4, 60);
    $footer_title    = vld_clamped_theme_mod('vld_footer_title_size', 16, 12, 28);
    $footer_text_size = vld_clamped_theme_mod('vld_footer_text_size', 13, 12, 18);
    $title_spacing   = vld_clamped_theme_mod('vld_footer_title_spacing', 8, 0, 24);
    $item_spacing    = vld_clamped_theme_mod('vld_footer_item_spacing', 6, 0, 18);
    $map_height      = vld_clamped_theme_mod('vld_footer_map_height', 105, 44, 280);
    $bottom_padding  = vld_clamped_theme_mod('vld_footer_bottom_padding', 8, 0, 24);
    $border_height   = vld_clamped_theme_mod('vld_footer_border_height', 2, 0, 8);
    $contact_density = get_theme_mod('vld_contact_density', 'ultra');
    $footer_density  = get_theme_mod('vld_footer_density', 'ultra');

    if ('ultra' === $contact_density) {
        $contact_padding = min($contact_padding, 6);
        $contact_gap     = min($contact_gap, 8);
        $heading_size    = min($heading_size, 20);
        $form_padding    = min($form_padding, 8);
    } elseif ('compact' === $contact_density) {
        $contact_padding = min($contact_padding, 12);
        $contact_gap     = min($contact_gap, 14);
        $form_padding    = min($form_padding, 12);
    }

    if ('ultra' === $footer_density) {
        $footer_padding = min($footer_padding, 4);
        $footer_gap     = min($footer_gap, 10);
        $footer_title   = min($footer_title, 14);
        $title_spacing  = min($title_spacing, 4);
        $item_spacing   = min($item_spacing, 4);
        $map_height     = min($map_height, 72);
        $bottom_padding = min($bottom_padding, 4);
    } elseif ('compact' === $footer_density) {
        $footer_padding = min($footer_padding, 8);
        $footer_gap     = min($footer_gap, 14);
        $title_spacing  = min($title_spacing, 6);
        $item_spacing   = min($item_spacing, 5);
        $map_height     = min($map_height, 90);
        $bottom_padding = min($bottom_padding, 6);
    }

    $mobile_contact     = $contact_padding;
    $mobile_form_padding = $form_padding;
    $mobile_footer      = $footer_padding;

    $colors = array(
        'contact_start' => sanitize_hex_color(get_theme_mod('vld_contact_color_start', '#091D3B')) ?: '#091D3B',
        'contact_end'   => sanitize_hex_color(get_theme_mod('vld_contact_color_end', '#163E73')) ?: '#163E73',
        'form'          => sanitize_hex_color(get_theme_mod('vld_contact_form_color', '#FFFFFF')) ?: '#FFFFFF',
        'accent'        => sanitize_hex_color(get_theme_mod('vld_region_accent_color', '#8F6B0B')) ?: '#8F6B0B',
        'button_start'  => sanitize_hex_color(get_theme_mod('vld_button_color_start', '#A77B08')) ?: '#A77B08',
        'button_end'    => sanitize_hex_color(get_theme_mod('vld_button_color_end', '#765505')) ?: '#765505',
        'footer'        => sanitize_hex_color(get_theme_mod('vld_footer_color', '#0F2C59')) ?: '#0F2C59',
        'footer_dark'   => sanitize_hex_color(get_theme_mod('vld_footer_dark_color', '#091D3B')) ?: '#091D3B',
        'footer_text'   => sanitize_hex_color(get_theme_mod('vld_footer_text_color', '#FFFFFF')) ?: '#FFFFFF',
    );
    $contact_text = vld_accessible_text_color('#FFFFFF', array($colors['contact_start'], $colors['footer'], $colors['contact_end']));
    $form_text    = vld_accessible_text_color('#0F2C59', $colors['form']);
    $button_text  = vld_accessible_text_color('#FFFFFF', array($colors['button_start'], $colors['button_end']));
    $footer_text_color = vld_accessible_text_color($colors['footer_text'], $colors['footer']);
    $bottom_text       = vld_accessible_text_color('#FFFFFF', $colors['footer_dark']);

    $css  = ':root{--vld-region-accent:' . $colors['accent'] . ';--vld-footer-text:' . $footer_text_color . ';--vld-contact-text:' . $contact_text . ';--vld-form-text:' . $form_text . ';--vld-button-text:' . $button_text . ';}';
    $css .= '.section-contact{padding:' . $contact_padding . 'px 0;background:linear-gradient(135deg,' . $colors['contact_start'] . ' 0%,' . $colors['footer'] . ' 60%,' . $colors['contact_end'] . ' 100%);}';
    $css .= '.contact-grid{grid-template-columns:minmax(0,' . $info_width . 'fr) minmax(0,' . $form_width . 'fr);gap:' . $contact_gap . 'px;}';
    $css .= '.contact-info,.contact-info h2{color:var(--vld-contact-text);}.contact-info h2{font-size:' . $heading_size . 'px;}';
    $css .= '.contact-form-wrap{padding:' . $form_padding . 'px;border-radius:' . $form_radius . 'px;background-color:' . $colors['form'] . ';}';
    $css .= '.contact-form-wrap h3,.section-contact .contact-form-wrap label{color:var(--vld-form-text);}';
    $css .= '.hotline-box i,.hotline-box div strong{color:var(--vld-region-accent);}';
    $css .= '.btn-submit,.newsletter-form button{color:var(--vld-button-text);background:linear-gradient(135deg,' . $colors['button_start'] . ',' . $colors['button_end'] . ');}';
    $css .= '.footer-border-top{height:' . $border_height . 'px;background-color:var(--vld-region-accent);}';
    $css .= '.footer-main{padding:' . $footer_padding . 'px 0;background-color:' . $colors['footer'] . ';color:var(--vld-footer-text);}';
    $css .= '.footer-grid{gap:' . $footer_gap . 'px;align-items:start;}';
    $css .= '.footer-col h4{margin-bottom:' . $title_spacing . 'px;padding-bottom:' . max(2, (int) floor($title_spacing / 2)) . 'px;font-size:' . $footer_title . 'px;color:var(--vld-footer-text);border-color:var(--vld-region-accent);}';
    $css .= '.footer-logo{margin-bottom:' . $item_spacing . 'px}.footer-col p{margin-bottom:' . $item_spacing . 'px;line-height:1.45}.footer-links,.footer-info{gap:' . $item_spacing . 'px}.footer-info{display:grid}.footer-info li{line-height:1.45}.footer-social{margin-top:' . $item_spacing . 'px}.footer-contact li{margin-bottom:' . $item_spacing . 'px}.newsletter-form{margin-top:' . $item_spacing . 'px}';
    $css .= '.footer-col p,.footer-links li a,.footer-contact li,.footer-info,.footer-info a,.footer-social a{font-size:' . $footer_text_size . 'px;color:var(--vld-footer-text);}';
    $css .= '.footer-contact li i,.footer-links li a:hover{color:var(--vld-region-accent);}';
    $css .= '.footer-social a:hover{background-color:var(--vld-region-accent);}';
    $css .= '.footer-map{height:' . $map_height . 'px;margin-bottom:' . $item_spacing . 'px;}';
    $css .= '.footer-bottom{padding:' . $bottom_padding . 'px 0;line-height:1.4;color:' . $bottom_text . ';background-color:' . $colors['footer_dark'] . ';}';

    if ('form-info' === get_theme_mod('vld_contact_layout_order', 'info-form')) {
        $css .= '.contact-info{order:2}.contact-form-wrap{order:1}';
    }

    if ('yes' === get_theme_mod('vld_contact_show_checklist', 'no')) {
        $css .= '.section-contact .checklist{display:block;}';
    }

    $css .= '@media(max-width:767px){.section-contact{padding:' . $mobile_contact . 'px 0}.contact-grid{grid-template-columns:minmax(0,1fr);gap:' . min(30, $contact_gap) . 'px}.contact-info,.contact-form-wrap{order:initial}.contact-form-wrap{padding:' . $mobile_form_padding . 'px}.footer-main{padding:' . $mobile_footer . 'px 0}.footer-grid{gap:' . min(24, $footer_gap) . 'px}}';

    wp_add_inline_style('vld-style', $css);
}
add_action('wp_enqueue_scripts', 'vld_enqueue_design_customizations', 30);

function vld_front_page_seo_title() {
    return vld_option('seo_title', 'Văn Lực Land – Dự án bất động sản TP.HCM');
}

function vld_front_page_seo_description() {
    return vld_option(
        'seo_description',
        'Văn Lực Land cập nhật dự án căn hộ, đất nền, nhà phố tại TP.HCM và vùng lân cận; thông tin pháp lý, bảng giá, ưu đãi mới minh bạch. Hotline 0932.032.111.'
    );
}

function vld_social_image_url() {
    if (is_singular() && has_post_thumbnail()) {
        return get_the_post_thumbnail_url(get_queried_object_id(), 'full');
    }

    return vld_option('seo_social_image', vld_option('slide1_img', VLD_URI . '/assets/images/hero-banner.jpg'));
}

function vld_normalize_phone($phone) {
    $digits = preg_replace('/\D+/', '', (string) $phone);
    if (0 === strpos($digits, '0')) {
        $digits = '84' . substr($digits, 1);
    }

    return '+' . ltrim($digits, '+');
}

/**
 * Keep the homepage title/description consistent across WordPress and the
 * supported SEO plugins, while leaving all post/project metadata editable.
 */
function vld_filter_front_page_title($title) {
    return is_front_page() ? vld_front_page_seo_title() : $title;
}
add_filter('pre_get_document_title', 'vld_filter_front_page_title', 20);
add_filter('rank_math/frontend/title', 'vld_filter_front_page_title', 20);
add_filter('wpseo_title', 'vld_filter_front_page_title', 20);
add_filter('aioseo_title', 'vld_filter_front_page_title', 20);

/**
 * Remove the legacy site-tagline boilerplate from blog category titles.
 * Keep any genuinely customized category title untouched.
 */
function vld_filter_category_title_boilerplate($title) {
    if (!is_category()) {
        return $title;
    }

    $decoded_title = html_entity_decode(wp_strip_all_tags((string) $title), ENT_QUOTES | ENT_HTML5, 'UTF-8');
    $has_legacy_boilerplate = false !== stripos($decoded_title, 'Sàn Bất Động Sản TP.HCM')
        && false !== stripos($decoded_title, 'Mua Bán Cho Thuê Nhà Đất');

    if (!$has_legacy_boilerplate) {
        return $title;
    }

    $category_name = single_cat_title('', false);
    return $category_name ? $category_name . ' | Văn Lực Land' : $title;
}
add_filter('pre_get_document_title', 'vld_filter_category_title_boilerplate', 100);
add_filter('rank_math/frontend/title', 'vld_filter_category_title_boilerplate', 100);

function vld_filter_front_page_description($description) {
    return is_front_page() ? vld_front_page_seo_description() : $description;
}
add_filter('rank_math/frontend/description', 'vld_filter_front_page_description', 20);
add_filter('wpseo_metadesc', 'vld_filter_front_page_description', 20);
add_filter('aioseo_description', 'vld_filter_front_page_description', 20);

function vld_filter_social_image($image) {
    if (!empty($image)) {
        return $image;
    }

    return vld_social_image_url();
}
add_filter('rank_math/opengraph/facebook/image', 'vld_filter_social_image', 20);
add_filter('rank_math/opengraph/twitter/image', 'vld_filter_social_image', 20);
add_filter('wpseo_opengraph_image', 'vld_filter_social_image', 20);
add_filter('wpseo_twitter_image', 'vld_filter_social_image', 20);

/**
 * Keep social previews complete when an individual page has not been given
 * custom OpenGraph copy. Existing Rank Math values always take precedence.
 */
function vld_filter_social_title($title) {
    return !empty($title) ? $title : wp_get_document_title();
}
add_filter('rank_math/opengraph/facebook/title', 'vld_filter_social_title', 20);
add_filter('rank_math/opengraph/twitter/title', 'vld_filter_social_title', 20);

function vld_filter_social_description($description) {
    if (!empty($description)) {
        return $description;
    }

    if (is_front_page()) {
        return vld_front_page_seo_description();
    }

    if (is_singular()) {
        $excerpt = wp_strip_all_tags(get_the_excerpt(get_queried_object_id()));
        if ($excerpt) {
            return $excerpt;
        }
    }

    return (string) get_bloginfo('description');
}
add_filter('rank_math/opengraph/facebook/description', 'vld_filter_social_description', 20);
add_filter('rank_math/opengraph/twitter/description', 'vld_filter_social_description', 20);

function vld_filter_social_image_alt($alt) {
    return !empty($alt) ? $alt : wp_get_document_title();
}
add_filter('rank_math/opengraph/facebook/image_alt', 'vld_filter_social_image_alt', 20);
add_filter('rank_math/opengraph/twitter/image_alt', 'vld_filter_social_image_alt', 20);

/**
 * Preserve WordPress/plugin noindex decisions on search/error/private pages;
 * extend only pages that are already intended for indexing.
 */
function vld_robots_directives($robots) {
    if (!is_admin() && !is_search() && !is_404() && !isset($robots['noindex'])) {
        $robots['index']               = true;
        $robots['follow']              = true;
        $robots['max-image-preview']   = 'large';
        $robots['max-snippet']         = '-1';
        $robots['max-video-preview']   = '-1';
    }

    return $robots;
}
add_filter('wp_robots', 'vld_robots_directives', 20);

/**
 * Fill missing attachment alt text without overwriting editorial alt text.
 */
function vld_attachment_image_attributes($attr, $attachment) {
    if (empty($attr['alt'])) {
        $alt = get_post_meta($attachment->ID, '_wp_attachment_image_alt', true);
        if (!$alt) {
            $alt = get_the_title($attachment->ID);
        }
        $attr['alt'] = wp_strip_all_tags($alt);
    }

    $attr['decoding'] = 'async';
    return $attr;
}
add_filter('wp_get_attachment_image_attributes', 'vld_attachment_image_attributes', 20, 2);

/**
 * Build a human-readable ALT fallback for legacy images pasted as raw HTML.
 * This changes only the rendered markup; it never overwrites Media Library
 * metadata or an ALT value that an editor has already supplied.
 */
function vld_content_image_alt_fallback($attachment_id, $image_html) {
    $alt = '';

    if ($attachment_id) {
        $alt = trim((string) get_post_meta($attachment_id, '_wp_attachment_image_alt', true));
        if (!$alt) {
            $alt = trim((string) get_the_title($attachment_id));
        }
    }

    if (!$alt && preg_match('/\\bsrc\\s*=\\s*(["\\\'])(.*?)\\1/i', $image_html, $source)) {
        $path = (string) wp_parse_url(html_entity_decode($source[2], ENT_QUOTES, 'UTF-8'), PHP_URL_PATH);
        $name = pathinfo(wp_basename($path), PATHINFO_FILENAME);
        $name = preg_replace('/(?:[-_](?:scaled|e\\d{8,}|\\d{2,4}x\\d{2,4}|copy|final|new|[0-9]+))+$/i', '', $name);
        $name = trim(preg_replace('/[-_]+/', ' ', $name));

        if ($name && !preg_match('/^(?:img|image|photo|picture|banner|logo|vip|untitled)$/i', $name)) {
            $alt = $name;
        }
    }

    if (!$alt) {
        $context_title = is_singular() ? get_the_title(get_queried_object_id()) : '';
        $alt = $context_title
            ? sprintf(__('Hình ảnh minh họa %s', 'vanlucland-developer'), $context_title)
            : sprintf(__('Hình ảnh %s', 'vanlucland-developer'), vld_option('brand_name', 'Văn Lực Land'));
    }

    return trim(wp_strip_all_tags($alt));
}

function vld_content_image_alt_attribute($filtered_image, $context, $attachment_id) {
    if (class_exists('WP_HTML_Tag_Processor')) {
        $processor = new WP_HTML_Tag_Processor($filtered_image);
        if ($processor->next_tag('IMG')) {
            $existing_alt = $processor->get_attribute('alt');
            if (null !== $existing_alt && '' !== trim((string) $existing_alt)) {
                return $filtered_image;
            }

            $processor->set_attribute('alt', vld_content_image_alt_fallback($attachment_id, $filtered_image));
            return $processor->get_updated_html();
        }
    }

    if (preg_match('/\\balt\\s*=\\s*(["\\\'])\\s*[^"\\\']+\\1/i', $filtered_image)) {
        return $filtered_image;
    }

    $alt = esc_attr(vld_content_image_alt_fallback($attachment_id, $filtered_image));
    if (preg_match('/\\balt\\s*=\\s*(["\\\'])\\s*\\1/i', $filtered_image)) {
        return preg_replace('/\\balt\\s*=\\s*(["\\\'])\\s*\\1/i', 'alt="' . $alt . '"', $filtered_image, 1);
    }

    return preg_replace('/<img\\b/i', '<img alt="' . $alt . '"', $filtered_image, 1);
}
add_filter('wp_content_img_tag', 'vld_content_image_alt_attribute', 20, 3);

/**
 * WordPress will generate WebP sub-sizes for future JPEG uploads when the
 * server image editor supports WebP. Existing images need thumbnail rebuild.
 */
function vld_prefer_webp_subsizes($formats) {
    if (function_exists('wp_image_editor_supports') && wp_image_editor_supports(array('mime_type' => 'image/webp'))) {
        $formats['image/jpeg'] = 'image/webp';
    }
    return $formats;
}
add_filter('image_editor_output_format', 'vld_prefer_webp_subsizes');

function vld_image_editor_quality($quality, $mime_type) {
    if (in_array($mime_type, array('image/jpeg', 'image/webp', 'image/avif'), true)) {
        return 82;
    }
    return $quality;
}
add_filter('wp_editor_set_quality', 'vld_image_editor_quality', 20, 2);

/**
 * Icon-only menu items still need an accessible name.
 */
function vld_menu_link_accessibility($atts, $item, $args) {
    $visible_title = trim(wp_strip_all_tags((string) $item->title));
    if ('' === $visible_title && untrailingslashit((string) $item->url) === untrailingslashit(home_url('/'))) {
        $atts['aria-label'] = __('Trang chủ', 'vanlucland-developer');

        $classes   = isset($atts['class']) ? preg_split('/\s+/', trim((string) $atts['class'])) : array();
        $classes[] = 'vld-home-link';
        $atts['class'] = implode(' ', array_unique(array_filter($classes)));
    }

    return $atts;
}
add_filter('nav_menu_link_attributes', 'vld_menu_link_accessibility', 20, 3);

/**
 * Replace legacy Font Awesome markup used by the icon-only Home menu item
 * with an inline SVG. The icon no longer depends on a webfont loading before
 * the navigation is painted, so LiteSpeed/CDN CSS deferral cannot turn it
 * into a missing-glyph square.
 */
function vld_menu_home_svg_icon($item_output, $item, $depth, $args) {
    $visible_title = trim(wp_strip_all_tags((string) $item->title));
    $is_home_link  = untrailingslashit((string) $item->url) === untrailingslashit(home_url('/'));

    if (0 !== (int) $depth || !$is_home_link || '' !== $visible_title) {
        return $item_output;
    }

    $icon = '<svg class="vld-home-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 10.75 12 3l9 7.75"></path><path d="M5 9.5V21h14V9.5"></path><path d="M9 21v-6h6v6"></path></svg>';
    $updated_output = preg_replace('/(<a\b[^>]*>).*?(<\/a>)/is', '$1' . $icon . '$2', $item_output, 1);

    return is_string($updated_output) ? $updated_output : $item_output;
}
add_filter('walker_nav_menu_start_el', 'vld_menu_home_svg_icon', 20, 4);

/**
 * Render attachment URLs with WordPress srcset/sizes; keep remote/theme URLs as a safe fallback.
 */
function vld_theme_webp_sources($url) {
    $url       = strtok((string) $url, '?');
    $theme_uri = untrailingslashit(VLD_URI);

    if (!$url || 0 !== strpos($url, $theme_uri . '/')) {
        return array();
    }

    $relative_path = ltrim(substr($url, strlen($theme_uri)), '/');
    $source_path   = trailingslashit(VLD_DIR) . $relative_path;
    $extension     = strtolower((string) pathinfo($source_path, PATHINFO_EXTENSION));

    if (!in_array($extension, array('jpg', 'jpeg', 'png'), true) || !file_exists($source_path)) {
        return array();
    }

    $path_without_extension = substr($source_path, 0, -(strlen($extension) + 1));
    $url_without_extension  = substr($url, 0, -(strlen($extension) + 1));
    $candidates             = array();

    foreach (array(96, 192, 320, 480, 768) as $width) {
        $candidate_path = $path_without_extension . '-' . $width . '.webp';
        if (file_exists($candidate_path)) {
            $candidates[] = array(
                'url'   => $url_without_extension . '-' . $width . '.webp',
                'width' => $width,
            );
        }
    }

    $full_path = $path_without_extension . '.webp';
    if (file_exists($full_path)) {
        $source_size = wp_getimagesize($source_path);
        $full_width  = !empty($source_size[0]) ? (int) $source_size[0] : 0;
        if ($full_width) {
            $candidates[] = array(
                'url'   => $url_without_extension . '.webp',
                'width' => $full_width,
            );
        }
    }

    if (!$candidates) {
        return array();
    }

    $deduplicated = array();
    foreach ($candidates as $candidate) {
        $deduplicated[$candidate['width']] = $candidate;
    }
    ksort($deduplicated, SORT_NUMERIC);
    $candidates = array_values($deduplicated);
    $largest    = end($candidates);

    return array(
        'src'    => $largest['url'],
        'srcset' => implode(
            ', ',
            array_map(
                static function ($candidate) {
                    return $candidate['url'] . ' ' . $candidate['width'] . 'w';
                },
                $candidates
            )
        ),
    );
}

function vld_image_html($url, $alt, $attributes = array(), $size = 'full') {
    $attachment_id = attachment_url_to_postid($url);

    if ($attachment_id) {
        return wp_get_attachment_image(
            $attachment_id,
            $size,
            false,
            array_merge(
                array(
                    'alt'      => $alt,
                    'decoding' => 'async',
                ),
                $attributes
            )
        );
    }

    // Auto generate responsive srcset for custom uploads
    $srcset = "";
    if (strpos($url, '/uploads/') !== false && substr($url, -5) === '.webp') {
        $base = substr($url, 0, -5);
        $url_480 = $base . '-480x300.webp';
        $url_768 = $base . '-768x480.webp';
        $path_480 = str_replace(site_url('/'), ABSPATH, $url_480);
        if (file_exists($path_480)) {
            $url_300 = $base . '-300x169.webp';
        $path_300 = str_replace(site_url('/'), ABSPATH, $url_300);
        if (!file_exists($path_300)) {
            $url_300 = $base . '-300x168.webp';
            $path_300 = str_replace(site_url('/'), ABSPATH, $url_300);
        }
        if (!file_exists($path_300)) {
            $url_300 = $base . '-300x200.webp';
            $path_300 = str_replace(site_url('/'), ABSPATH, $url_300);
        }
        if (file_exists($path_300)) {
            $srcset = "{$url_300} 300w, {$url_480} 480w, {$url_768} 768w, {$url} 1200w";
        } else {
            $srcset = "{$url_480} 480w, {$url_768} 768w, {$url} 1200w";
        }
        }
    }

    $attributes = array_merge(
        array(
            'src'      => $url,
            'alt'      => $alt,
            'decoding' => 'async',
        ),
        $attributes
    );
    if ($srcset && empty($attributes['srcset'])) {
        $attributes['srcset'] = $srcset;
        if (empty($attributes['sizes'])) {
            $attributes['sizes'] = '(max-width: 600px) 480px, (max-width: 991px) 768px, 1200px';
        }
    }

    $allowed_attributes = array('src', 'srcset', 'sizes', 'alt', 'class', 'width', 'height', 'loading', 'decoding', 'fetchpriority', 'style', 'data-no-lazy', 'data-litespeed-no-lazy');
    $html = '<img';
    foreach ($attributes as $name => $value) {
        if (in_array($name, $allowed_attributes, true) && '' !== $value && null !== $value) {
            $html .= sprintf(' %s="%s"', esc_attr($name), esc_attr($value));
        }
    }
    $html .= ' />';
    return $html;
}

 
function vld_preload_front_page_hero() {
    if (!is_front_page()) {
        return;
    }

    // Không preload ảnh Hero nếu người quản trị đã bỏ block Hero khỏi bố cục kéo-thả.
    if (vld_front_page_uses_hybrid_blocks() && !has_block('vld/hero', get_queried_object_id())) {
        return;
    }

    $hero_url      = vld_option('slide1_img', VLD_URI . '/assets/images/hero-banner.jpg');
    $attachment_id = attachment_url_to_postid($hero_url);
    $srcset = $attachment_id ? wp_get_attachment_image_srcset($attachment_id, 'large') : '';
    $webp         = $attachment_id ? array() : vld_theme_webp_sources($hero_url);

    if ($webp) {
        echo '<link rel="preload" as="image" type="image/webp" href="' . esc_url($webp['src']) . '" fetchpriority="high" imagesrcset="' . esc_attr($webp['srcset']) . '" imagesizes="(max-width: 575px) 480px, (max-width: 991px) 768px, 1200px">' . "\n";
        return;
    }

    echo '<link rel="preload" as="image" href="' . esc_url($hero_url) . '" fetchpriority="high"';
    if ($srcset) {
        echo ' imagesrcset="' . esc_attr($srcset) . '" imagesizes="(max-width: 575px) 480px, (max-width: 991px) 768px, 1200px"';
    }
    echo '>' . "\n";
}
// add_action('wp_head', 'vld_preload_front_page_hero', 2);

// 6. AJAX handler for contact form
function vld_handle_contact_form() {
    check_ajax_referer('vld_nonce', 'nonce');

    $honeypot = sanitize_text_field(wp_unslash($_POST['website'] ?? ''));
    if ('' !== $honeypot) {
        wp_send_json_error(array('message' => 'Yêu cầu không hợp lệ.'), 400);
    }

    $source  = sanitize_key(wp_unslash($_POST['source'] ?? 'contact'));
    $name    = sanitize_text_field(wp_unslash($_POST['name'] ?? ''));
    $phone   = sanitize_text_field(wp_unslash($_POST['phone'] ?? ''));
    $email   = sanitize_email(wp_unslash($_POST['email'] ?? ''));
    $project = sanitize_text_field(wp_unslash($_POST['project'] ?? ''));
    $message = sanitize_textarea_field(wp_unslash($_POST['message'] ?? ''));

    $allowed_sources = array(
        'contact', 'popup', 'newsletter', 'content-cta',
        'project-single-sales', 'article-consultation',
        'footer-quick-lead', 'calculator-lead'
    );
    if (!in_array($source, $allowed_sources, true)) {
        $source = 'contact';
    }

    $phone_digits = preg_replace('/\D+/', '', $phone);
    $phone_valid  = '' === $phone || (bool) preg_match('/^(?:84|0)(?:3|5|7|8|9)\d{8}$/', $phone_digits);
    $email_valid  = '' === $email || is_email($email);

    if (!$phone_valid || !$email_valid || ('' === $phone && '' === $email)) {
        wp_send_json_error(array('message' => 'Vui lòng nhập số điện thoại hoặc email hợp lệ.'), 422);
    }

    if ('newsletter' !== $source && vld_string_length($name) < 2) {
        wp_send_json_error(array('message' => 'Vui lòng nhập họ tên hợp lệ.'), 422);
    }

    $remote_ip = sanitize_text_field(wp_unslash($_SERVER['REMOTE_ADDR'] ?? 'unknown'));
    $rate_key  = 'vld_lead_' . md5(wp_salt('nonce') . '|' . $remote_ip);
    $rate      = (int) get_transient($rate_key);
    if ($rate >= 5) {
        wp_send_json_error(array('message' => 'Bạn đã gửi quá nhiều yêu cầu. Vui lòng thử lại sau 15 phút.'), 429);
    }
    set_transient($rate_key, $rate + 1, 15 * MINUTE_IN_SECONDS);

    // 1. SAVE LEAD SECURELY TO DATABASE FIRST (Zero lead loss)
    $lead_id = vld_save_lead_to_db(array(
        'name'       => $name,
        'phone'      => $phone,
        'email'      => $email,
        'project'    => $project,
        'source'     => $source,
        'message'    => $message,
        'ip'         => $remote_ip,
        'user_agent' => wp_unslash($_SERVER['HTTP_USER_AGENT'] ?? ''),
    ));

    // 2. DISPATCH EMAIL NOTIFICATION
    $to      = get_option('admin_email');
    $subject = '[Văn Lực Land] Đăng ký mới - ' . $source . ' (' . ($project ?: 'Tư vấn chung') . ')';
    $body    = "Khách hàng mới đã được lưu vào hệ thống (Lead #{$lead_id}).

"
             . "Họ tên: {$name}
"
             . "Điện thoại: {$phone}
"
             . "Email: {$email}
"
             . "Dự án: {$project}
"
             . "Nguồn: {$source}
"
             . "Lời nhắn: {$message}

"
             . "Xem chi tiết tại: " . admin_url('admin.php?page=vld-leads');
    $headers = array('Content-Type: text/plain; charset=UTF-8');

    @wp_mail($to, $subject, $body, $headers);

    wp_send_json_success(array('message' => 'Đăng ký thành công! Chuyên viên Văn Lực sẽ liên hệ lại ngay.'));
}
add_action('wp_ajax_vld_contact', 'vld_handle_contact_form');
add_action('wp_ajax_nopriv_vld_contact', 'vld_handle_contact_form');

// 7. Technical SEO and structured data
function vld_has_seo_plugin() {
    return defined('RANK_MATH_VERSION')
        || defined('WPSEO_VERSION')
        || defined('AIOSEO_VERSION');
}

function vld_schema_same_as() {
    $candidates = array(
        vld_option('facebook', ''),
        vld_option('youtube', ''),
        vld_option('zalo', ''),
    );
    $generic = array(
        'https://facebook.com',
        'https://www.facebook.com',
        'https://youtube.com',
        'https://www.youtube.com',
    );

    return array_values(
        array_filter(
            array_unique($candidates),
            function ($url) use ($generic) {
                return $url && !in_array(untrailingslashit($url), $generic, true);
            }
        )
    );
}

function vld_current_canonical_url() {
    if (is_front_page()) {
        return home_url('/');
    }
    if (is_singular()) {
        return get_permalink(get_queried_object_id());
    }
    if (is_category() || is_tax() || is_tag()) {
        $term_link = get_term_link(get_queried_object_id());
        if (!is_wp_error($term_link)) {
            return $term_link;
        }
    }
    if (is_post_type_archive()) {
        return get_post_type_archive_link(get_query_var('post_type'));
    }

    global $wp;
    $request = isset($wp->request) ? $wp->request : '';
    return home_url('/' . ltrim($request, '/') . '/');
}

/**
 * Filter Rank Math canonical fallback for custom taxonomies
 */
add_filter('rank_math/frontend/canonical', function($canonical) {
    if (is_category('cam-nang')) {
        $hub_url = get_category_link(get_queried_object_id());
        return is_wp_error($hub_url) ? $canonical : $hub_url;
    }
    if (empty($canonical)) {
        return vld_current_canonical_url();
    }
    return $canonical;
}, 99);

/**
 * Cẩm nang is a curated content hub with original articles, not a thin tag or
 * internal search page. Override the stale per-term noindex left in Rank Math.
 */
function vld_force_indexable_camnang_hub($robots) {
    if (!is_category('cam-nang')) {
        return $robots;
    }

    unset($robots['noindex'], $robots['nofollow']);
    $robots['index']  = 'index';
    $robots['follow'] = 'follow';
    return $robots;
}
add_filter('rank_math/frontend/robots', 'vld_force_indexable_camnang_hub', 999);

