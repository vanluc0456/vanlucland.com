function vld_register_project_cpt() {
    $labels = array(
        'name'               => 'Dự án',
        'singular_name'      => 'Dự án',
        'menu_name'          => 'Dự án BĐS',
        'add_new'            => 'Thêm dự án',
        'add_new_item'       => 'Thêm dự án mới',
        'edit_item'          => 'Sửa dự án',
        'new_item'           => 'Dự án mới',
        'view_item'          => 'Xem dự án',
        'search_items'       => 'Tìm dự án',
        'not_found'          => 'Không tìm thấy dự án',
        'not_found_in_trash' => 'Không có dự án trong thùng rác',
        'all_items'          => 'Tất cả dự án',
    );

    $args = array(
        'labels'             => $labels,
        'public'             => true,
        'has_archive'        => true,
        'rewrite'            => array('slug' => 'du-an'),
        'supports'           => array('title', 'editor', 'thumbnail', 'excerpt'),
        'taxonomies'         => array('danh_muc_du_an'),
        'menu_icon'          => 'dashicons-building',
        'menu_position'      => 5,
        'show_in_rest'       => true,
    );

    register_post_type('du_an', $args);

    // 8.1 One dedicated project taxonomy. Posts keep their own categories/tags.
    $tax_labels = array(
        'name'              => 'Loại hình dự án',
        'singular_name'     => 'Loại hình dự án',
        'search_items'      => 'Tìm loại hình',
        'all_items'         => 'Tất cả loại hình',
        'parent_item'       => 'Loại hình cha',
        'parent_item_colon' => 'Loại hình cha:',
        'edit_item'         => 'Sửa loại hình',
        'update_item'       => 'Cập nhật loại hình',
        'add_new_item'      => 'Thêm loại hình',
        'new_item_name'     => 'Tên loại hình mới',
        'menu_name'         => 'Loại hình dự án',
    );

    $tax_args = array(
        'hierarchical'      => true, // Hiển thị dạng ô tick chọn (Checkbox)
        'labels'            => $tax_labels,
        'show_ui'           => true,
        'show_admin_column' => true,
        'query_var'         => true,
        'rewrite'           => array('slug' => 'danh-muc-du-an'),
        'show_in_rest'      => true,
        'meta_box_cb'       => 'vld_project_type_meta_box',
    );

    register_taxonomy('danh_muc_du_an', array('du_an'), $tax_args);

}
add_action('init', 'vld_register_project_cpt');

/**
 * Keep every public project listing predictable and paginated.
 *
 * This applies only to the main query on the project archive and project
 * taxonomy pages. The featured-project query on the front page and all admin
 * screens keep their existing limits.
 */
function vld_project_archive_posts_per_page($query) {
    if (is_admin() || !$query->is_main_query()) {
        return;
    }

    if ($query->is_post_type_archive('du_an') || $query->is_tax('danh_muc_du_an')) {
        $query->set('posts_per_page', 6);
    }
}
add_action('pre_get_posts', 'vld_project_archive_posts_per_page', 20);

/**
 * Automatically include child categories (Phap Ly BDS, Tai Chinh & Lai Vay, Danh Gia Du An)
 * when querying the main 'Cam Nang Mua Nha' category archive.
 */
function vld_cam_nang_include_subcategories($query) {
    if (is_admin() || !$query->is_main_query()) {
        return;
    }

    if ($query->is_category('cam-nang')) {
        $cam_nang_id = 6;
        $child_cat_ids = get_term_children($cam_nang_id, 'category');
        $all_cat_ids = array_merge(
            array($cam_nang_id, 2405, 2407), // 2405: Phap Ly BDS, 2407: Danh Gia Du An
            is_array($child_cat_ids) ? $child_cat_ids : array()
        );
        $all_cat_ids = array_unique(array_filter(array_map('intval', $all_cat_ids)));

        $query->set('category_name', '');
        $query->set('category__in', $all_cat_ids);
    }
}
add_action('pre_get_posts', 'vld_cam_nang_include_subcategories', 20);

/**
 * Old releases mixed display positions into the project taxonomy. Preserve
 * those terms in storage for reversibility, but keep them out of current admin
 * selectors and the block editor's taxonomy panel.
 */
function vld_hide_legacy_project_position_terms($terms, $taxonomies) {
    $is_rest_request = defined('REST_REQUEST') && REST_REQUEST;
    if ((!is_admin() && !$is_rest_request) || !in_array('danh_muc_du_an', (array) $taxonomies, true)) {
        return $terms;
    }
    if (!is_array($terms)) {
        return $terms;
    }

    $legacy_names = array('Dự án Nổi bật Trang chủ');
    $legacy_slugs = array('du-an-noi-bat-trang-chu');

    return array_values(
        array_filter(
            $terms,
            static function ($term) use ($legacy_names, $legacy_slugs) {
                if (!($term instanceof WP_Term)) {
                    return true;
                }
                return !in_array($term->name, $legacy_names, true)
                    && !in_array($term->slug, $legacy_slugs, true);
            }
        )
    );
}
add_filter('get_terms', 'vld_hide_legacy_project_position_terms', 10, 2);

