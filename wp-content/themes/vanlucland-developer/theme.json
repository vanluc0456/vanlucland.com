{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1440px"
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "units": ["px", "rem", "%", "vw"]
    },
    "typography": {
      "fluid": true,
      "dropCap": false,
      "fontFamilies": [
        {
          "fontFamily": "\"Roboto\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif",
          "name": "Nội dung hệ thống",
          "slug": "body"
        },
        {
          "fontFamily": "\"Montserrat\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif",
          "name": "Tiêu đề hệ thống",
          "slug": "heading"
        }
      ],
      "fontSizes": [
        {
          "fluid": {
            "min": "16px",
            "max": "18px"
          },
          "name": "Nội dung",
          "size": "17px",
          "slug": "body"
        },
        {
          "fluid": {
            "min": "28px",
            "max": "46px"
          },
          "name": "Tiêu đề lớn",
          "size": "40px",
          "slug": "display"
        }
      ]
    },
    "color": {
      "custom": false,
      "defaultPalette": false,
      "palette": [
        {
          "color": "#0F2C59",
          "name": "Xanh thương hiệu",
          "slug": "primary"
        },
        {
          "color": "#8F6B0B",
          "name": "Vàng nhấn",
          "slug": "accent"
        },
        {
          "color": "#FFFFFF",
          "name": "Trắng",
          "slug": "white"
        },
        {
          "color": "#263244",
          "name": "Chữ chính",
          "slug": "foreground"
        },
        {
          "color": "#F6F8FB",
          "name": "Nền nhạt",
          "slug": "background"
        }
      ]
    }
  },
  "styles": {
    "spacing": {
      "blockGap": "1.5rem"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "17px",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "700",
          "lineHeight": "1.2"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        }
      }
    }
  }
}
